                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel x:Name="LibraryStats" Grid.Column="1" Margin="24,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource TechnicalLabel}" Text="AVAILABLE RECORDS" />
                                        <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" FontFamily="Arial Narrow" FontSize="34" FontWeight="Bold" Text="{Binding LibraryCount, StringFormat={}{0:00}}" />
                                    </StackPanel>
                                    <StackPanel x:Name="LibraryActionPanel"
                                                Grid.Column="2"
                                                Margin="16,0,10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <Button x:Name="RefreshLibraryButton"
                                                MinWidth="144"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding RefreshLibraryCommand}"
