<Window x:Class="FieldStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FIELD STATION / MAXIMAL"
        Width="1600" Height="960" MinWidth="820" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource InkBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DrawingBrush x:Key="GlobalGrid" TileMode="Tile" Viewport="0,0,54,54" ViewportUnits="Absolute"
                      Viewbox="0,0,54,54" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="Transparent">
                    <GeometryDrawing.Pen><Pen Brush="#0DFFFFFF" Thickness="1" /></GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="54,0" /><LineGeometry StartPoint="0,0" EndPoint="0,54" /></GeometryGroup></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="RailColumn" Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" /><RowDefinition Height="*" />
            <RowDefinition x:Name="MobileNavRow" Height="0" /><RowDefinition Height="31" />
        </Grid.RowDefinitions>

        <!-- Desktop pale rail -->
        <Border x:Name="DesktopRail" Grid.RowSpan="4" Background="{StaticResource PaperBrush}"
                BorderBrush="{StaticResource Black10Brush}" BorderThickness="0,0,1,0" Panel.ZIndex="20">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="102" /><RowDefinition Height="*" /><RowDefinition Height="86" /></Grid.RowDefinitions>
                <Grid Margin="18,17,18,13">
                    <Rectangle Fill="{StaticResource InkBrush}" />
                    <Path Data="M3,34 L25,3 L47,3 L25,34 Z" Fill="{StaticResource SignalBrush}" Stretch="Uniform" Margin="10" />
                    <TextBlock Text="FS" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,11" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource RailItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="61" Margin="7,0,3,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Index}" FontFamily="{StaticResource MonoFont}" FontSize="8" Opacity="0.55" />
                                <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="13" FontWeight="Bold" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="2" Text="{Binding EnglishLabel}" FontFamily="{StaticResource MonoFont}" FontSize="7" Opacity="0.55" Margin="0,2,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="18,0,18,15" VerticalAlignment="Bottom">
                    <Rectangle Height="1" Fill="{StaticResource Black10Brush}" Margin="0,0,0,10" />
                    <TextBlock Text="END / 04" FontFamily="{StaticResource MonoFont}" FontSize="8" FontWeight="Bold" />
                    <TextBlock Text="MAXIMAL" FontFamily="{StaticResource MonoFont}" FontSize="7" Opacity="0.52" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Title / utility dock -->
        <Border Grid.Column="1" Background="#121212" BorderBrush="{StaticResource White14Brush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Panel.ZIndex="25">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Rectangle Width="19" Height="4" Fill="{StaticResource SignalBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="FIELD STATION" Foreground="{StaticResource PaperBrush}" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text=" / " Foreground="{StaticResource White52Brush}" Margin="8,0" />
                    <TextBlock Text="{Binding CurrentCode}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" />
                    <TextBlock Text=" / " Foreground="{StaticResource White28Brush}" Margin="8,0" />
                    <TextBlock Text="{Binding Workspace}" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" />
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding ToggleMotionCommand}" Style="{StaticResource OutlineButton}"
                        Content="{Binding MotionLabel}" Padding="12,6" MinHeight="30" Margin="0,6,8,6"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource UtilityButton}" Content="—" Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource UtilityButton}" Content="□" Click="Maximize_Click" ToolTip="最大化或还原" />
                    <Button Style="{StaticResource UtilityButton}" Content="×" Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Layered global stage -->
        <Grid Grid.Row="1" Grid.Column="1" ClipToBounds="True">
            <Rectangle Fill="{StaticResource InkBrush}" />
            <Rectangle x:Name="AmbientGrid" Fill="{StaticResource GlobalGrid}" Opacity="0.8" IsHitTestVisible="False">
                <Rectangle.RenderTransform><TranslateTransform x:Name="AmbientGridTransform" /></Rectangle.RenderTransform>
            </Rectangle>
            <Path Data="M900,-80 L1380,-80 L920,1040 L440,1040 Z" Fill="#08FFFFFF" Stretch="None" HorizontalAlignment="Right" IsHitTestVisible="False" />
            <Path Data="M1080,-30 L1450,-30 L1080,870 L710,870 Z" Fill="#05000000" Stretch="None" HorizontalAlignment="Right" IsHitTestVisible="False" />

            <Grid Width="430" Height="430" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-130,0" Opacity="0.22" IsHitTestVisible="False">
                <Grid.RenderTransform><RotateTransform x:Name="CalibrationTransform" CenterX="215" CenterY="215" /></Grid.RenderTransform>
                <Ellipse Stroke="White" StrokeThickness="1" />
                <Ellipse Stroke="White" StrokeThickness="1" Margin="52" />
                <Ellipse Stroke="{StaticResource SignalBrush}" StrokeThickness="2" Margin="108" StrokeDashArray="2 12" />
                <Line X1="215" Y1="0" X2="215" Y2="430" Stroke="White" StrokeThickness="1" />
                <Line X1="0" Y1="215" X2="430" Y2="215" Stroke="White" StrokeThickness="1" />
            </Grid>

            <ContentControl x:Name="PageContent" Content="{Binding CurrentPage}" Panel.ZIndex="4" />

            <!-- Directional page wipe. It covers content only during real transitions. -->
            <Rectangle x:Name="TransitionWipe" Fill="{StaticResource SignalBrush}" Opacity="0"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" Panel.ZIndex="10">
                <Rectangle.RenderTransform><ScaleTransform ScaleX="0" ScaleY="1" /></Rectangle.RenderTransform>
            </Rectangle>

            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.23" Panel.ZIndex="6">
                <TextBlock Text="100" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="7" Margin="0,0,7,3" />
                <Rectangle Width="18" Height="1" Fill="White" HorizontalAlignment="Right" />
                <Rectangle Width="8" Height="1" Fill="White" HorizontalAlignment="Right" Margin="0,24,0,0" />
                <Rectangle Width="8" Height="1" Fill="White" HorizontalAlignment="Right" Margin="0,24,0,0" />
                <Rectangle Width="18" Height="1" Fill="White" HorizontalAlignment="Right" Margin="0,24,0,0" />
                <Rectangle Width="8" Height="1" Fill="White" HorizontalAlignment="Right" Margin="0,24,0,0" />
                <Rectangle Width="18" Height="1" Fill="White" HorizontalAlignment="Right" Margin="0,24,0,0" />
                <TextBlock Text="000" Foreground="White" FontFamily="{StaticResource MonoFont}" FontSize="7" Margin="0,3,7,0" />
            </StackPanel>
        </Grid>

        <!-- Responsive bottom navigation replaces the rail under 1000px. -->
        <Border x:Name="MobileNavigation" Grid.Row="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="{StaticResource PaperBrush}" Panel.ZIndex="30">
            <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource BottomNavItem}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate><StackPanel Margin="10,8" HorizontalAlignment="Center"><TextBlock Text="{Binding Index}" FontFamily="{StaticResource MonoFont}" FontSize="8" HorizontalAlignment="Center" /><TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" /><TextBlock Text="{Binding EnglishLabel}" FontFamily="{StaticResource MonoFont}" FontSize="7" Opacity="0.56" HorizontalAlignment="Center" /></StackPanel></DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Real global state baseline -->
        <Border Grid.Row="3" Grid.Column="1" Background="{StaticResource InkDeepBrush}" BorderBrush="{StaticResource White14Brush}" BorderThickness="0,1,0,0" Panel.ZIndex="31">
            <Grid Margin="18,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ActivityBeacon" Width="6" Height="6" Fill="{StaticResource OnlineBrush}" Margin="0,0,8,0" /><TextBlock Text="{Binding Mode}" Foreground="{StaticResource White76Brush}" Style="{StaticResource MicroLabel}" /></StackPanel>
                <TextBlock x:Name="TickerText" Grid.Column="1" Text="BACKEND DECOUPLED  /  PAGE FACTORY READY  /  REGION HOST READY  /  MOTION POLICY ACTIVE" Foreground="{StaticResource White28Brush}" FontFamily="{StaticResource MonoFont}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform></TextBlock>
                <TextBlock Grid.Column="2" Text="ENDFIELD / MAXIMAL / 04" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
