<Window x:Class="WallpaperField.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WallpaperField.Controls"
        xmlns:local="clr-namespace:WallpaperField"
        Title="Wallpaper Field"
        Width="1480"
        Height="900"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource InkBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      CornerRadius="16"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ProblemFilterComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SignalBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProblemFilterComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="14,0,40,0" />
            <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ProblemFilterComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Padding="{TemplateBinding Padding}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="ComboChrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="11">
                                            <Grid>
                                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                <TextBlock Margin="0,0,14,0"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Segoe Fluent Icons"
                                                           FontSize="11"
                                                           Text="&#xE70D;" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource SignalPressedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="None">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="330"
                                        Margin="0,5,0,0"
                                        Padding="5"
                                        Background="{DynamicResource PaperBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.46" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DrawingBrush x:Key="EngineeringGridBrush"
                      TileMode="Tile"
                      Viewport="0,0,56,56"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Geometry="M 0,0 L 56,0 M 0,0 L 0,56">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#17000000" Thickness="1" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 8,0 L 8,4 M 16,0 L 16,3 M 24,0 L 24,4 M 32,0 L 32,3 M 40,0 L 40,4 M 48,0 L 48,3">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#22000000" Thickness="1" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
            <DrawingBrush.Transform>
                <TranslateTransform />
            </DrawingBrush.Transform>
        </DrawingBrush>

        <DataTemplate x:Key="WallpaperCardTemplate">
            <Button x:Name="WallpaperCardButton"
                    Height="{DynamicResource ComfortableCardHeight}"
                    MinHeight="0"
                    Margin="{DynamicResource ComfortableCardMargin}"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Style="{StaticResource CardButton}"
                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding Title, StringFormat=打开项目目录：{0}}"
                    ToolTip="打开已有输出目录；尚未解包时打开源目录">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="CardPreviewColumn"
                                          Width="{DynamicResource ComfortableCardPreviewWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="66" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource InkSoftBrush}"
                            ClipToBounds="True"
                            CornerRadius="15,3,3,15">
                        <Grid>
                            <controls:AnimatedPreviewImage SourcePath="{Binding PreviewPath}"
                                                           AnimationEnabled="{Binding MotionEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                           DecodePixelWidth="480"
                                                           Stretch="UniformToFill"
                                                           Panel.ZIndex="1"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           AutomationProperties.Name="{Binding Title, StringFormat=壁纸预览：{0}}">
                                <controls:AnimatedPreviewImage.Style>
                                    <Style TargetType="{x:Type controls:AnimatedPreviewImage}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:AnimatedPreviewImage.Style>
                            </controls:AnimatedPreviewImage>

                            <Grid Panel.ZIndex="0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe Fluent Icons"
                                               FontSize="27"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Text="&#xE91B;" />
                                    <TextBlock x:Name="CardPreviewEmptyLabel"
                                               Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="无信息" />
                                </StackPanel>
                            </Grid>

                            <Border Height="34"
                                    Padding="11,0"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Left"
                                    Panel.ZIndex="2"
                                    Background="{DynamicResource OverlayBrush}"
                                    CornerRadius="0,0,12,0">
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource PaperBrush}"
                                           Text="{Binding WorkshopId, StringFormat=ID / {0}}" />
                            </Border>

                            <Border Margin="0,10,10,0"
                                    Padding="9,5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Panel.ZIndex="2"
                                    Background="{DynamicResource SignalBrush}"
                                    CornerRadius="10"
                                    ToolTip="{Binding WarningSummary}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,5,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="Black"
                                               Foreground="{DynamicResource SignalTextBrush}"
                                               Text="!" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource SignalTextBrush}"
                                               Text="{Binding WarningCount}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="12,0,0,10"
                                    Padding="9,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Panel.ZIndex="2"
                                    CornerRadius="9"
                                    ToolTip="{Binding PackageStatusDetail}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource Ink42Brush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnpackableContent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                                <Setter Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnpackableContent}" Value="True">
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SignalTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="10"
                                               Text="&#xE7C5;" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Text="{Binding PackageStatus}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid x:Name="CardContentGrid" Grid.Column="1" Margin="20,17,18,15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="CardTechnicalHeader"
                                   Grid.Row="0"
                                   Style="{StaticResource TechnicalLabel}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="WALLPAPER / PACKAGE RECORD" />
                        <TextBlock x:Name="CardTitle"
                                   Grid.Row="1"
                                   Margin="0,8,0,5"
                                   VerticalAlignment="Top"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkBrush}"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <Grid x:Name="CardMetadataGrid" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource TechnicalLabel}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="SOURCE FOLDER" />
                                <TextBlock Margin="0,3,0,0"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding FolderName}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="28,0,0,0">
                                <TextBlock Style="{StaticResource TechnicalLabel}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="UNPACK STATE" />
                                <TextBlock Margin="0,3,0,0"
                                           HorizontalAlignment="Right"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding PackageStatus}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="2"
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InkBrush}"
                            CornerRadius="19">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsUnpackSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="13"
                                   Foreground="{DynamicResource PaperBrush}"
                                   Text="&#xE72A;" />
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                             Value="Compact">
                    <Setter TargetName="WallpaperCardButton"
                            Property="Height"
                            Value="{DynamicResource CompactCardHeight}" />
                    <Setter TargetName="WallpaperCardButton"
                            Property="Margin"
                            Value="{DynamicResource CompactCardMargin}" />
                    <Setter TargetName="CardPreviewColumn"
                            Property="Width"
                            Value="{DynamicResource CompactCardPreviewWidth}" />
                    <Setter TargetName="CardContentGrid" Property="Margin" Value="16,13,14,12" />
                    <Setter TargetName="CardTechnicalHeader" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CardMetadataGrid" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CardPreviewEmptyLabel" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="CardTitle" Property="Margin" Value="0" />
                    <Setter TargetName="CardTitle" Property="FontSize" Value="16" />
                    <Setter TargetName="CardTitle" Property="VerticalAlignment" Value="Center" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="WindowFrame"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Background="{DynamicResource PaperBrush}"
            CornerRadius="16"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Global navigation rail. All three application pages remain reachable at every width. -->
            <Border x:Name="NavigationRail"
                    Grid.Column="0"
                    Background="{DynamicResource InkBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="226" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                <Setter Property="Width" Value="92" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="18,18,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="64">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44"
                                Height="44"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource SignalBrush}"
                                CornerRadius="12">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Arial Narrow"
                                           FontSize="19"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="WF" />
                                <Border Width="7"
                                        Height="7"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        BorderBrush="{DynamicResource InkBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="BrandCopy" Grid.Column="1" Margin="10,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="Arial Narrow"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PaperBrush}"
                                       Text="WALLPAPER" />
                            <TextBlock Margin="0,1,0,0"
                                       Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                       Text="FIELD / CATALOG" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,4,0,18"
                            BorderBrush="{DynamicResource Paper24Brush}"
                            BorderThickness="0,1,0,0" />

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="NavSectionLabel"
                                   Margin="12,0,0,10"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="OPERATIONS / 03">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="ScanNavButton"
                                Margin="0,0,0,8"
                                Command="{Binding NavigateScanCommand}"
                                ToolTip="扫描中心"
                                AutomationProperties.Name="扫描中心">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE721;" />
                                <StackPanel x:Name="ScanNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="扫描中心" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="SCAN FIELD" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Text="01" />
                            </Grid>
                        </Button>

                        <Button x:Name="LibraryNavButton"
                                Command="{Binding NavigateLibraryCommand}"
                                ToolTip="输出壁纸库"
                                AutomationProperties.Name="输出壁纸库">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE8F1;" />
                                <StackPanel x:Name="LibraryNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="输出库" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="OUTPUT LIBRARY" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Text="02" />
                            </Grid>
                        </Button>

                        <Button x:Name="ProblemNavButton"
                                Margin="0,8,0,0"
                                Command="{Binding NavigateProblemsCommand}"
                                ToolTip="问题中心"
                                AutomationProperties.Name="问题中心">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProblemsPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE814;" />
                                <StackPanel x:Name="ProblemNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="问题中心" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="PROBLEM CENTER" />
                                </StackPanel>
                                <TextBlock Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           Text="03" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="RailFooter" Grid.Row="4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Margin" Value="7,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="12"
                                Background="{DynamicResource Paper08Brush}"
                                BorderBrush="{DynamicResource Paper24Brush}"
                                BorderThickness="1"
                                CornerRadius="13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SignalBeacon"
                                         Width="8"
                                         Height="8"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Margin="1,4,0,0"
                                         Fill="{DynamicResource SuccessBrush}" />
                                <StackPanel x:Name="RailFooterCopy" Grid.Column="1">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource TechnicalLabel}"
                                               Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                               Text="OUTPUT TARGET" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource PaperBrush}"
                                               Text="{Binding OutputPath, TargetNullValue=尚未选择}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OutputPath}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RailFooterStatus"
                                   Grid.Row="1"
                                   Margin="12,12,0,0"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="LOCAL-FIRST  ·  BACKEND READY">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource PaperBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="28,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="WALLPAPER ENGINE / LOCAL WORKSHOP" />
                            <Border Width="1" Height="15" Margin="16,0" Background="{DynamicResource BorderBrush}" />
                            <TextBlock x:Name="PageBreadcrumb"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding CurrentPageTitle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="0,0,18,0"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InkBrush}"
                                AutomationProperties.LiveSetting="Polite"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalPressedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource TechnicalLabel}"
                                           Foreground="{DynamicResource PaperBrush}"
                                           Text="{Binding StateLabel}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Width="40" Height="40" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE921;" />
                            </Button>
                            <Button Width="40" Height="40" Margin="5,0,0,0" Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原窗口">
                                <TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE922;" />
                            </Button>
                            <Button Width="40" Height="40" Margin="5,0,0,0" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- Four coordinated layers: engineering grid, page identifier, route wedge, calibration device. -->
                    <Rectangle x:Name="GridLayer"
                               Margin="-56"
                               Fill="{StaticResource EngineeringGridBrush}"
                               IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="BackgroundGridOffset" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <TextBlock Margin="0,-58,-6,0"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               IsHitTestVisible="False"
                               FontFamily="Arial Narrow"
                               FontSize="232"
                               FontWeight="Black"
                               Foreground="{DynamicResource Ink05Brush}"
                               Text="{Binding PageCode}" />
                    <Path Margin="0,0,-58,-72"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Width="330"
                          Height="210"
                          IsHitTestVisible="False"
                          Fill="#13FFFA00"
                          Data="M 330,0 L 330,210 L 0,210 Z" />

                    <!-- Scan mode owns a real source-to-index route instrument. -->
                    <Canvas x:Name="ScanStageOverlay"
                            IsHitTestVisible="False"
                            Opacity="0.13">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Path Stroke="{DynamicResource InkBrush}"
                              StrokeThickness="1"
                              StrokeDashArray="7,8"
                              Data="M 54,566 L 260,566 L 330,518 L 590,518 L 660,566 L 954,566" />
                        <Ellipse Canvas.Left="49" Canvas.Top="561" Width="10" Height="10" Fill="{DynamicResource SignalPressedBrush}" />
                        <Ellipse Canvas.Left="325" Canvas.Top="513" Width="10" Height="10" Fill="{DynamicResource InkBrush}" />
                        <Ellipse Canvas.Left="585" Canvas.Top="513" Width="10" Height="10" Fill="{DynamicResource InkBrush}" />
                        <Ellipse Canvas.Left="949" Canvas.Top="561" Width="10" Height="10" Fill="{DynamicResource SignalPressedBrush}" />
                        <TextBlock Canvas.Left="54" Canvas.Top="578" Style="{StaticResource TechnicalLabel}" Text="SOURCE ROOT" />
                        <TextBlock Canvas.Left="330" Canvas.Top="530" Style="{StaticResource TechnicalLabel}" Text="PROJECT.JSON" />
                        <TextBlock Canvas.Left="590" Canvas.Top="530" Style="{StaticResource TechnicalLabel}" Text="PREVIEW MEDIA" />
                        <TextBlock Canvas.Left="868" Canvas.Top="578" Style="{StaticResource TechnicalLabel}" Text="LOCAL INDEX" />
                    </Canvas>

                    <!-- Library mode replaces the route with an indexed media aperture. -->
                    <Canvas x:Name="LibraryStageOverlay"
                            IsHitTestVisible="False"
                            Opacity="0.12">
                        <Canvas.Style>
                            <Style TargetType="Canvas">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Canvas.Style>
                        <Path Stroke="{DynamicResource InkBrush}"
                              StrokeThickness="1"
                              Data="M 64,300 L 64,258 L 104,258 M 64,300 L 64,660 L 104,660 M 1040,258 L 1080,258 L 1080,300 M 1040,660 L 1080,660 L 1080,620" />
                        <Line X1="128" Y1="286" X2="1016" Y2="286" Stroke="{DynamicResource InkBrush}" StrokeDashArray="1,12" />
                        <Line X1="128" Y1="632" X2="1016" Y2="632" Stroke="{DynamicResource InkBrush}" StrokeDashArray="1,12" />
                        <TextBlock Canvas.Left="82" Canvas.Top="318"
                                   FontFamily="Arial Narrow"
                                   FontSize="62"
                                   FontWeight="Black"
                                   Foreground="{DynamicResource InkBrush}"
                                   Text="MEDIA / CATALOG" />
                        <TextBlock Canvas.Left="84" Canvas.Top="382"
                                   Style="{StaticResource TechnicalLabel}"
                                   Text="OUTPUT ROOT · METADATA · PREVIEW · FOLDER ACCESS" />
                    </Canvas>

                    <Grid x:Name="CalibrationInstrument"
                          Width="210"
                          Height="210"
                          Margin="0,40,44,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False"
                          Opacity="0.17"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="CalibrationRotation" />
                        </Grid.RenderTransform>
                        <Ellipse Margin="14" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" StrokeDashArray="2,8" />
                        <Ellipse Margin="48" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Line X1="105" Y1="0" X2="105" Y2="210" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Line X1="0" Y1="105" X2="210" Y2="105" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Path Stroke="{DynamicResource SignalPressedBrush}"
                              StrokeThickness="7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 105,18 A 87,87 0 0 1 185,72" />
                        <Border Width="16" Height="16" Background="{DynamicResource InkBrush}" CornerRadius="8" />
                    </Grid>

                    <!-- Page 01: scan workspace -->
                    <Grid x:Name="ScanView" RenderTransformOrigin="0.5,0.5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="34,24,28,20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Margin" Value="22,16,18,14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Regular}">
                                        <Setter Property="Margin" Value="28,20,22,16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid x:Name="ScanPageLayout" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <Grid x:Name="ScanPageHeader" Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TechnicalLabel}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="FIELD INDEX / 01 · SOURCE INTAKE" />
                                        <TextBlock x:Name="ScanPageTitle"
                                                   Margin="0,8,0,0"
                                                   Style="{StaticResource SectionTitle}"
                                                   AutomationProperties.HeadingLevel="Level1"
                                                   Text="扫描壁纸项目" />
                                        <TextBlock x:Name="ScanDescription"
                                                   Margin="2,9,0,0"
                                                   MaxWidth="630"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="读取 Workshop 子目录中的 project.json 与 preview；扫描结果保留在内存中，不向输出目录写入文件。"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid x:Name="ScanStats" Grid.Column="1" Margin="28,0,10,0" VerticalAlignment="Bottom">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Width="90">
                                            <TextBlock Style="{StaticResource TechnicalLabel}" Text="SCANNED" />
                                            <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding ScannedCount, StringFormat={}{0:00}}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="1" Height="42" Margin="18,0" Background="{DynamicResource BorderBrush}" />
                                        <StackPanel Grid.Column="2" Width="90">
                                            <TextBlock Style="{StaticResource TechnicalLabel}" Text="NO PREVIEW" />
                                            <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding MissingPreviewCount, StringFormat={}{0:00}}" />
                                        </StackPanel>
                                        <Border Grid.Column="3" Width="1" Height="42" Margin="18,0" Background="{DynamicResource BorderBrush}" />
                                        <StackPanel Grid.Column="4" Width="90">
                                            <TextBlock Style="{StaticResource TechnicalLabel}" Text="READY" />
                                            <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding PackageReadyCount, StringFormat={}{0:00}}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <Border x:Name="ScanActionPanel"
                                        Grid.Row="1"
                                        Style="{StaticResource DarkPanel}"
                                        Padding="24,18"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="SOURCE ROOT" />
                                                <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="壁纸目录" />
                                            </StackPanel>
                                            <TextBox x:Name="SourcePathTextBox"
                                                     Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Style="{StaticResource PathTextBox}"
                                                     AutomationProperties.Name="Wallpaper Engine 壁纸目录"
                                                     Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="例如 E:\SteamLibrary\steamapps\workshop\content\431960" />
                                            <Button x:Name="BrowseSourceButton"
                                                    Grid.Column="2"
                                                    Style="{StaticResource GhostButton}"
                                                    Foreground="{DynamicResource PaperBrush}"
                                                    BorderBrush="{DynamicResource Paper24Brush}"
                                                    Command="{Binding BrowseSourceCommand}"
                                                    AutomationProperties.Name="选择 Wallpaper Engine 壁纸目录"
                                                    Content="选择目录" />
                                        </Grid>

                                        <Border Grid.Row="1" Margin="0,17" Background="{DynamicResource Paper24Brush}" />

                                        <Grid Grid.Row="2" Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="OUTPUT ROOT" />
                                                <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="输出目录" />
                                            </StackPanel>
                                            <TextBox x:Name="OutputPathTextBox"
                                                     Grid.Column="1"
                                                     Margin="0,0,12,0"
                                                     Style="{StaticResource PathTextBox}"
                                                     AutomationProperties.Name="扫描输出目录"
                                                     Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="扫描不会写入此目录；仅在解包选中项目时创建对应输出" />
                                            <Button x:Name="BrowseOutputButton"
                                                    Grid.Column="2"
                                                    Style="{StaticResource GhostButton}"
                                                    Foreground="{DynamicResource PaperBrush}"
                                                    BorderBrush="{DynamicResource Paper24Brush}"
                                                    Command="{Binding BrowseOutputCommand}"
                                                    AutomationProperties.Name="选择扫描输出目录"
                                                    Content="选择目录" />
                                        </Grid>

                                        <Grid Grid.Row="3">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Margin" Value="120,18,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                                            <Setter Property="Margin" Value="0,16,0,0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="ScanButton"
                                                    MinWidth="168"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ScanCommand}"
                                                    AutomationProperties.Name="扫描壁纸项目">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,9,0" FontFamily="Segoe Fluent Icons" Text="&#xE721;" />
                                                    <TextBlock Text="{Binding ScanButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CancelScanButton"
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    MinWidth="168"
                                                    Margin="0,8,0,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding CancelScanCommand}"
                                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="取消扫描"
                                                    Content="取消扫描" />
                                            <Button x:Name="UnpackButton"
                                                    Grid.Column="1"
                                                    MinWidth="152"
                                                    Margin="12,0,0,0"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding UnpackCommand}"
                                                    AutomationProperties.Name="解包勾选的 PKG 或视频项目"
                                                    ToolTip="{Binding UnpackToolTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Margin="0,0,9,0" FontFamily="Segoe Fluent Icons" Text="&#xE7B8;" />
                                                    <TextBlock Text="{Binding UnpackButtonText}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="CancelUnpackButton"
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    MinWidth="152"
                                                    Margin="12,8,0,0"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding CancelUnpackCommand}"
                                                    Visibility="{Binding IsUnpacking, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    AutomationProperties.Name="取消解包"
                                                    Content="取消解包" />
                                            <StackPanel x:Name="UnpackProgressPanel" VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Grid.Row" Value="0" />
                                                        <Setter Property="Grid.RowSpan" Value="2" />
                                                        <Setter Property="Grid.Column" Value="2" />
                                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                                        <Setter Property="Margin" Value="24,0,0,0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                                <Setter Property="Grid.Row" Value="2" />
                                                                <Setter Property="Grid.RowSpan" Value="1" />
                                                                <Setter Property="Grid.Column" Value="0" />
                                                                <Setter Property="Grid.ColumnSpan" Value="3" />
                                                                <Setter Property="Margin" Value="0,14,0,0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Grid>
                                                    <ProgressBar x:Name="UnpackProgressBar"
                                                                 Height="5"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                 Value="{Binding ProgressValue, Mode=OneWay}" />
                                                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Paper24Brush}" />
                                                </Grid>
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="UnpackStatusText"
                                                               Grid.Column="0"
                                                               Style="{StaticResource TechnicalLabel}"
                                                               Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                               Text="{Binding StatusText}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="UnpackStageText"
                                                               Grid.Column="1"
                                                               Margin="16,0,0,0"
                                                               Style="{StaticResource TechnicalLabel}"
                                                               Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                               Text="{Binding CurrentStage}" />
                                                    <TextBlock x:Name="UnpackWorkText"
                                                               Grid.Column="2"
                                                               Margin="16,0,0,0"
                                                               HorizontalAlignment="Right"
                                                               Style="{StaticResource TechnicalLabel}"
                                                               Foreground="{DynamicResource PaperBrush}"
                                                               Text="{Binding UnpackWorkText}" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="ScanProblemSummary"
                                        Grid.Row="2"
                                        Margin="0,0,0,12"
                                        Padding="14,11"
                                        Background="{DynamicResource PaperElevatedBrush}"
                                        BorderBrush="{DynamicResource SignalPressedBrush}"
                                        BorderThickness="5,1,1,1"
                                        CornerRadius="12"
                                        AutomationProperties.LiveSetting="Polite">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="24" Height="24" Background="{DynamicResource SignalBrush}" CornerRadius="8">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="{DynamicResource SignalTextBrush}" Text="!" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                            <TextBlock Style="{StaticResource TechnicalLabel}" Text="PROBLEM SUMMARY / 扫描与解包" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkBrush}"
                                                       Text="{Binding ScanIssueSummary}" />
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                MinWidth="124"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding NavigateProblemsCommand}"
                                                Content="查看全部问题"
                                                AutomationProperties.Name="查看全部扫描与解包问题" />
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="3" Margin="2,2,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="扫描结果" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Text="NAME FILTER / 实时筛选">
                                            <TextBlock.Style>
                                                <Style BasedOn="{StaticResource TechnicalLabel}"
                                                       TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                     Value="{x:Static local:ShellLayoutMode.Regular}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border x:Name="ScanEfficiencyToolbar"
                                            Grid.Column="1"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ToggleButton x:Name="OnlyProcessableFilter"
                                                          MinWidth="68"
                                                          Margin="0,0,4,0"
                                                          Style="{StaticResource FilterToggleButton}"
                                                          IsChecked="{Binding ShowOnlyProcessable, Mode=TwoWay}"
                                                          Content="可处理"
                                                          ToolTip="仅显示可处理项目"
                                                          AutomationProperties.Name="仅显示可处理的扫描结果" />
                                            <ToggleButton x:Name="OnlyProblemsFilter"
                                                          MinWidth="68"
                                                          Margin="0,0,8,0"
                                                          Style="{StaticResource FilterToggleButton}"
                                                          IsChecked="{Binding ShowOnlyProblems, Mode=TwoWay}"
                                                          Content="有问题"
                                                          ToolTip="仅显示有开放问题的项目"
                                                          AutomationProperties.Name="仅显示有开放问题的扫描结果" />
                                            <Button x:Name="SelectCurrentMatchesButton"
                                                    MinWidth="88"
                                                    Margin="0,0,4,0"
                                                    Style="{StaticResource EfficiencyButton}"
                                                    Command="{Binding SelectCurrentMatchesCommand}"
                                                    Content="选择匹配"
                                                    ToolTip="选择当前匹配中的全部可处理项目"
                                                    AutomationProperties.Name="选择当前匹配中的可处理项目" />
                                            <Button x:Name="ClearUnpackSelectionButton"
                                                    MinWidth="60"
                                                    Margin="0,0,4,0"
                                                    Style="{StaticResource EfficiencyButton}"
                                                    Command="{Binding ClearUnpackSelectionCommand}"
                                                    Content="清空"
                                                    ToolTip="清除全部解包选择，包括当前筛选隐藏的项目"
                                                    AutomationProperties.Name="清除全部解包选择" />
                                            <ToggleButton x:Name="CompactDensityToggle"
                                                          MinWidth="68"
                                                          Style="{StaticResource FilterToggleButton}"
                                                          IsChecked="{Binding IsCompactDensity, Mode=TwoWay}"
                                                          Content="紧凑"
                                                          ToolTip="切换紧凑卡片密度"
                                                          AutomationProperties.Name="使用紧凑卡片密度" />
                                        </WrapPanel>
                                    </Border>
                                    <Grid x:Name="ScanSearchPanel"
                                          Grid.Column="2"
                                          Height="50">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Width" Value="280" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                                        <Setter Property="Width" Value="250" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="{x:Static local:ShellLayoutMode.Wide}">
                                                        <Setter Property="Width" Value="330" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBox x:Name="ScanSearchBox"
                                                 Style="{StaticResource SearchTextBox}"
                                                 AutomationProperties.Name="搜索扫描结果中的壁纸名称"
                                                 AutomationProperties.HelpText="输入名称后仅显示标题中包含该关键词的壁纸"
                                                 Text="{Binding ScanSearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                                        <TextBlock Margin="16,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource InkBrush}"
                                                   Text="&#xE721;" />
                                        <TextBlock Margin="47,0,130,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="搜索名称">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=ScanSearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Height="32"
                                                Padding="10,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Margin" Value="0,0,7,0" />
                                                    <Setter Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScanSearchText}" Value="True">
                                                            <Setter Property="Margin" Value="0,0,51,0" />
                                                            <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                             <TextBlock x:Name="SelectionSummaryText"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource InkBrush}"
                                                        Text="{Binding SelectionSummaryText}"
                                                        AutomationProperties.LiveSetting="Polite">
                                                 <AutomationProperties.Name>
                                                     <Binding Path="SelectionSummaryText" />
                                                 </AutomationProperties.Name>
                                             </TextBlock>
                                        </Border>
                                        <Button HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,3,0"
                                                Command="{Binding ClearScanSearchCommand}"
                                                AutomationProperties.Name="清除扫描结果搜索"
                                                ToolTip="清除搜索"
                                                Content="&#xE711;">
                                            <Button.Style>
                                                <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScanSearchText}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Border Margin="2,0"
                                                VerticalAlignment="Bottom"
                                                IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Height" Value="1" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasScanSearchText}" Value="True">
                                                            <Setter Property="Height" Value="3" />
                                                            <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                </Grid>

                                <Grid Grid.Row="4" MinHeight="48">
                                    <ListBox x:Name="ScanResultsList"
                                             ItemsSource="{Binding FilteredScannedWallpapers}"
                                             ItemTemplate="{StaticResource WallpaperCardTemplate}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.CacheLength="1,2"
                                             VirtualizingPanel.CacheLengthUnit="Page">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="IsTabStop" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Grid>
                                                                <ContentPresenter />
                                                                <CheckBox Width="38"
                                                                          Height="38"
                                                                          Margin="0,0,22,12"
                                                                          HorizontalAlignment="Right"
                                                                          VerticalAlignment="Center"
                                                                          Panel.ZIndex="5"
                                                                          IsChecked="{Binding IsSelectedForUnpack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding CanSelectForUnpack}"
                                                                          AutomationProperties.Name="{Binding Title, StringFormat=选择解包：{0}}"
                                                                          ToolTip="勾选后才会解包或复制此项目">
                                                                    <CheckBox.Template>
                                                                        <ControlTemplate TargetType="CheckBox">
                                                                            <Border x:Name="SelectionBox"
                                                                                    Width="38"
                                                                                    Height="38"
                                                                                    Background="{DynamicResource PaperBrush}"
                                                                                    BorderBrush="{DynamicResource Ink42Brush}"
                                                                                    BorderThickness="2"
                                                                                    CornerRadius="10">
                                                                                <TextBlock x:Name="SelectionGlyph"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center"
                                                                                           FontFamily="Segoe UI Symbol"
                                                                                           FontSize="17"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{DynamicResource SignalTextBrush}"
                                                                                           Text="✓"
                                                                                           Visibility="Collapsed" />
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsChecked" Value="True">
                                                                                    <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource SignalBrush}" />
                                                                                    <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                                                                    <Setter TargetName="SelectionGlyph" Property="Visibility" Value="Visible" />
                                                                                </Trigger>
                                                                                <Trigger Property="IsEnabled" Value="False">
                                                                                    <Setter TargetName="SelectionBox" Property="Opacity" Value="0.35" />
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </CheckBox.Template>
                                                                </CheckBox>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>

                                    <Border Padding="28"
                                            Background="{DynamicResource PaperBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVisibleScanResults}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="29" Foreground="{DynamicResource TextMutedBrush}" Text="&#xEC31;" />
                                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding ScanEmptyTitle}" />
                                            <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ScanEmptyDescription}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                        </Grid>
                    </Grid>

                    <!-- Page 02: output library -->
                    <Grid x:Name="LibraryView" RenderTransformOrigin="0.5,0.5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="34,24,28,20" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Margin" Value="22,16,18,14" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Regular}">
                                        <Setter Property="Margin" Value="28,20,22,16" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                                <Grid x:Name="LibraryPageHeader" Grid.Row="0" Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TechnicalLabel}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="LOCAL ARCHIVE / 02 · OUTPUT CATALOG" />
