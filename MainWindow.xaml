<Window x:Class="WallpaperField.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WallpaperField"
        xmlns:views="clr-namespace:WallpaperField.Views"
        Title="Wallpaper Field"
        Width="1480"
        Height="900"
        MinWidth="920"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      CornerRadius="4"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            BorderBrush="{DynamicResource BorderStrongBrush}"
            BorderThickness="1"
            Background="{DynamicResource BackgroundBrush}"
            CornerRadius="4"
            ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Global navigation rail. All four application pages remain reachable at every width. -->
            <Border x:Name="NavigationRail"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource InkBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="184" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                <Setter Property="Width" Value="76" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="10,14,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="48">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44"
                                Height="44"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentActionBrush}"
                                CornerRadius="3">
                            <Grid>
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Arial Narrow"
                                           FontSize="19"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource SignalTextBrush}"
                                           Text="WF" />
                                <Border Width="7"
                                        Height="7"
                                        Margin="0,0,5,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                            </Grid>
                        </Border>
                        <StackPanel x:Name="BrandCopy" Grid.Column="1" Margin="5,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="Arial Narrow"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PaperBrush}"
                                       Text="WALLPAPER" />
                            <TextBlock Margin="0,1,0,0"
                                       Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                       Text="FIELD / CATALOG" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,4,0,8"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="0,1,0,0" />

                    <StackPanel Grid.Row="2">
                        <TextBlock x:Name="NavSectionLabel"
                                   Margin="10,0,0,8"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="工作区 / WORKSPACE">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TechnicalLabel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button x:Name="ScanNavButton"
                                Margin="0,0,0,8"
                                Command="{Binding NavigateScanCommand}"
                                ToolTip="扫描中心"
                                AutomationProperties.Name="扫描中心">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE721;" />
                                <StackPanel x:Name="ScanNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="扫描中心" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="SCAN FIELD" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="BrowseNavButton"
                                Margin="0,0,0,8"
                                Command="{Binding NavigateBrowseCommand}"
                                ToolTip="项目浏览"
                                AutomationProperties.Name="项目浏览">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBrowsePage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE8B7;" />
                                <StackPanel x:Name="BrowseNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="项目浏览" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="PROJECT BROWSER" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Right"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Text="02" />
                                    <TextBlock HorizontalAlignment="Right"
                                               Margin="0,2,0,0"
                                               FontFamily="Consolas"
                                               FontSize="9"
                                               Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}{0} 项}" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="LibraryNavButton"
                                Margin="0,0,0,8"
                                Command="{Binding NavigateLibraryCommand}"
                                ToolTip="输出壁纸库"
                                AutomationProperties.Name="输出壁纸库">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE8F1;" />
                                <StackPanel x:Name="LibraryNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="输出库" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="OUTPUT LIBRARY" />
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="ProblemNavButton"
                                Command="{Binding NavigateProblemsCommand}"
                                ToolTip="问题中心"
                                AutomationProperties.Name="问题中心">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProblemsPage}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="17"
                                           Text="&#xE814;" />
                                <StackPanel x:Name="ProblemNavCopy" Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="问题中心" />
                                    <TextBlock Margin="0,2,0,0" FontFamily="Consolas" FontSize="9" Text="PROBLEM CENTER" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid x:Name="RailFooter" Grid.Row="4">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Margin" Value="7,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Padding="12"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="SignalBeacon"
                                         Width="8"
                                         Height="8"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top"
                                         Margin="1,4,0,0"
                                         Fill="{DynamicResource SuccessBrush}" />
                                <StackPanel x:Name="RailFooterCopy" Grid.Column="1">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource TechnicalLabel}"
                                               Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                               Text="OUTPUT TARGET" />
                                    <TextBlock Margin="0,5,0,0"
                                               FontFamily="Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource PaperBrush}"
                                               Text="{Binding OutputPath, TargetNullValue=尚未选择}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OutputPath}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="RailFooterStatus"
                                   Grid.Row="1"
                                   Margin="12,12,0,0"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="LOCAL WORKSHOP">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource BackgroundBrush}"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="WALLPAPER FIELD / LOCAL WORKSHOP" />
                            <Border Width="1" Height="15" Margin="16,0" Background="{DynamicResource BorderBrush}" />
                            <TextBlock x:Name="PageBreadcrumb"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="{Binding CurrentPageTitle}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Margin="0,0,10,0"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InkBrush}"
                                AutomationProperties.LiveSetting="Polite"
                                CornerRadius="3">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,7,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Working">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusKind}" Value="Error">
                                                    <Setter Property="Fill" Value="{DynamicResource SignalPressedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Style="{StaticResource TechnicalLabel}"
                                           Foreground="{DynamicResource PaperBrush}"
                                           Text="{Binding StateLabel}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Width="40" Height="40" Style="{StaticResource IconButton}" Click="Minimize_Click" ToolTip="最小化" AutomationProperties.Name="最小化窗口">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE921;" />
                            </Button>
                            <Button Width="40" Height="40" Margin="5,0,0,0" Style="{StaticResource IconButton}" Click="Maximize_Click" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原窗口">
                                <TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE922;" />
                            </Button>
                            <Button Width="40" Height="40" Margin="5,0,0,0" Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                                <TextBlock FontFamily="Segoe Fluent Icons" FontSize="11" Text="&#xE8BB;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- Quiet catalogue surface; retained named motion layers preserve reduced-motion behavior. -->
                    <Rectangle x:Name="GridLayer"
                               Visibility="Collapsed"
                               Margin="-56"
                               Fill="{StaticResource EngineeringGridBrush}"
                               IsHitTestVisible="False">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="BackgroundGridOffset" />
                        </Rectangle.RenderTransform>
                    </Rectangle>



                    <Grid x:Name="CalibrationInstrument"
                          Visibility="Collapsed"
                          Width="210"
                          Height="210"
                          Margin="0,40,44,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False"
                          Opacity="0.17"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="CalibrationRotation" />
                        </Grid.RenderTransform>
                        <Ellipse Margin="14" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" StrokeDashArray="2,8" />
                        <Ellipse Margin="48" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Line X1="105" Y1="0" X2="105" Y2="210" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Line X1="0" Y1="105" X2="210" Y2="105" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" />
                        <Path Stroke="{DynamicResource SignalPressedBrush}"
                              StrokeThickness="7"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 105,18 A 87,87 0 0 1 185,72" />
                        <Border Width="16" Height="16" Background="{DynamicResource InkBrush}" CornerRadius="3" />
                    </Grid>

                    <views:ScanPageView x:Name="ScanPage" />

                    <views:BrowsePageView x:Name="BrowsePage" />

                    <views:LibraryPageView x:Name="LibraryPage" />

                    <views:ProblemCenterView x:Name="ProblemCenterPage" />

                </Grid>

                <!-- Real status only: current operation, record counts, app identity. -->
                <Border Grid.Row="2"
                        Background="{DynamicResource InkBrush}"
                        AutomationProperties.LiveSetting="Polite">
                    <Grid Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="5" Margin="0,0,8,0" Background="{DynamicResource AccentActionBrush}" CornerRadius="3" />
                            <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="18,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="9"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="{Binding OutputPath}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource TechnicalLabel}"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   Text="WALLPAPER FIELD · LOCAL" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
