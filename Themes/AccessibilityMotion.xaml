<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- System-owned High Contrast resources and the shared two-ring focus treatment. -->
    <!-- Runtime high-contrast overrides use these system-owned colors. -->
    <SolidColorBrush x:Key="HighContrastWindowBrush"
                     Color="{DynamicResource {x:Static SystemColors.WindowColorKey}}" />
    <SolidColorBrush x:Key="HighContrastWindowTextBrush"
                     Color="{DynamicResource {x:Static SystemColors.WindowTextColorKey}}" />
    <SolidColorBrush x:Key="HighContrastHighlightBrush"
                     Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
    <SolidColorBrush x:Key="HighContrastHighlightTextBrush"
                     Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
    <SolidColorBrush x:Key="HighContrastDisabledBrush"
                     Color="{DynamicResource {x:Static SystemColors.GrayTextColorKey}}" />

    <!-- Keyboard focus -->
    <Style x:Key="FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid Margin="-6" SnapsToDevicePixels="True">
                        <Border BorderBrush="{DynamicResource FocusOuterBrush}"
                                BorderThickness="2"
                                CornerRadius="18" />
                        <Border Margin="3"
                                BorderBrush="{DynamicResource FocusInnerBrush}"
                                BorderThickness="2"
                                CornerRadius="15" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
