<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WallpaperField.Controls">

    <!-- Generic converters, controls, input, scrolling, tooltip, and progress behavior. -->
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Square terminal actions: a cut corner marks every command, an edge rail marks hover. -->
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="{x:Type Button}">
        <Grid x:Name="Root"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ActionCornerRadius}"
                    Effect="{TemplateBinding Effect}" />

            <Border x:Name="HoverWash"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{DynamicResource ActionCornerRadius}"
                    IsHitTestVisible="False"
                    Opacity="0" />

            <Border x:Name="EdgeMarker"
                    Width="3"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"
                    IsHitTestVisible="False"
                    Opacity="0" />

            <Path x:Name="CornerCut"
                  Width="7"
                  Height="7"
                  Margin="0,0,2,2"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Data="M 7,0 L 7,7 0,7 Z"
                  Fill="{TemplateBinding Foreground}"
                  IsHitTestVisible="False"
                  Opacity="0.85" />

            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="HoverWash" Property="Opacity" Value="0.07" />
                <Setter TargetName="EdgeMarker" Property="Opacity" Value="1" />
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SignalPressedBrush}" />
                <Setter TargetName="HoverWash" Property="Opacity" Value="0.14" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
                <Setter TargetName="CornerCut" Property="Opacity" Value="0.3" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Caption and glyph-only actions keep the square chrome without the command corner. -->
    <ControlTemplate x:Key="IconButtonTemplate" TargetType="{x:Type Button}">
        <Grid x:Name="IconRoot"
              Background="Transparent"
              SnapsToDevicePixels="True">
            <Border x:Name="IconChrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="IconWash"
                    Background="{TemplateBinding Foreground}"
                    IsHitTestVisible="False"
                    Opacity="0" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="IconChrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                <Setter TargetName="IconWash" Property="Opacity" Value="0.1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="IconWash" Property="Opacity" Value="0.18" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="IconRoot" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="EndfieldButtonBase" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="controls:MotionAssist.Hover" Value="Lift" />
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
    </Style>

    <!-- One cyan signal action per surface: ink text on cyan stays above 9:1. -->
    <Style x:Key="PrimaryButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Effect" Value="{DynamicResource ButtonShadow}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="116" />
    </Style>

    <Style x:Key="SecondaryButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Effect" Value="{DynamicResource ButtonShadow}" />
        <Setter Property="MinWidth" Value="104" />
    </Style>

    <Style x:Key="GhostButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="IconButton"
           BasedOn="{StaticResource GhostButton}"
           TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="controls:MotionAssist.Hover" Value="None" />
        <Setter Property="Template" Value="{StaticResource IconButtonTemplate}" />
    </Style>

    <Style x:Key="EfficiencyButton"
           BasedOn="{StaticResource GhostButton}"
           TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="FilterToggleButton" TargetType="{x:Type ToggleButton}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid x:Name="ToggleRoot" Background="Transparent">
                        <Border x:Name="ToggleChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="ToggleRule"
                                Height="3"
                                VerticalAlignment="Bottom"
                                Background="{TemplateBinding Foreground}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleChrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="ToggleRule" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ToggleChrome" Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBackgroundBrush}" />
        <Setter Property="SelectionTextBrush" Value="{DynamicResource SelectionTextBrush}" />
        <Setter Property="SelectionOpacity" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid x:Name="InputRoot" Background="Transparent">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CompactActionCornerRadius}" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" />
                        <Border x:Name="InputIndicator"
                                Width="3"
                                Margin="0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentActionBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="InputFocusOuter"
                                Margin="-4"
                                BorderBrush="{DynamicResource FocusOuterBrush}"
                                BorderThickness="2"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="InputFocusInner"
                                Margin="-1"
                                BorderBrush="{DynamicResource FocusInnerBrush}"
                                BorderThickness="2"
                                CornerRadius="0"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="InputIndicator" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="InputIndicator" Property="Opacity" Value="1" />
                            <Setter TargetName="InputFocusOuter" Property="Opacity" Value="1" />
                            <Setter TargetName="InputFocusInner" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputRoot" Property="Opacity" Value="0.46" />
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PathTextBox"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{DynamicResource TechnicalFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Search is an action-first field instrument: icon and live match state
         are composed by the view, while this style preserves the shared signal
         focus rail and readable keyboard focus treatment. -->
    <Style x:Key="SearchTextBox"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="46,0,154,0" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="WorkspaceCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Grid x:Name="CheckRoot" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="CheckChrome"
                                Width="20"
                                Height="20"
                                Margin="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="0">
                            <TextBlock x:Name="CheckGlyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="12"
                                       Foreground="{DynamicResource SignalTextBrush}"
                                       Text="&#xE73E;"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="4,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentActionBrush}" />
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource AccentActionBrush}" />
                            <Setter TargetName="CheckGlyph" Property="Text" Value="&#xE738;" />
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckRoot" Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource WorkspaceCheckBox}" />

    <!-- Scroll bars -->
    <Style x:Key="EndfieldScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0"
                            Opacity="0.42" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource AccentActionBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="14" Background="Transparent" SnapsToDevicePixels="True">
            <Border Width="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource BorderBrush}" />
            <Track x:Name="PART_Track"
                   Margin="4,0"
                   IsDirectionReversed="True"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Vertical"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EndfieldScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="14" Background="Transparent" SnapsToDevicePixels="True">
            <Border Height="1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderBrush}" />
            <Track x:Name="PART_Track"
                   Margin="0,4"
                   IsDirectionReversed="False"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Horizontal"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EndfieldScrollThumb}" MinWidth="28" MinHeight="6" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips: ink slips with a cyan signal edge. -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <Border Width="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentActionBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Determinate task progress uses the cyan signal; lime stays reserved for verified state. -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource AccentActionBrush}" />
        <Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" />
                        <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                            <Border Background="{TemplateBinding Foreground}" />
                            <Border Width="2"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource TextPrimaryBrush}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="72" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
