<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        WALLPAPER FIELD / ENDFIELD-INSPIRED MAXIMAL THEME
        Family and depth remain independent: these resources define the Endfield
        palette and interaction grammar while page composition owns depth-4 layers.
    -->

    <!-- Core color tokens -->
    <Color x:Key="InkColor">#FF191919</Color>
    <Color x:Key="InkRaisedColor">#FF242424</Color>
    <Color x:Key="InkSoftColor">#FF323232</Color>
    <Color x:Key="PaperColor">#FFF2F2F0</Color>
    <Color x:Key="PaperElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="PaperMutedColor">#FFE6E6E1</Color>
    <Color x:Key="PaperPressedColor">#FFDADAD4</Color>
    <Color x:Key="SignalColor">#FFFFFA00</Color>
    <Color x:Key="SignalPressedColor">#FFE8E300</Color>
    <Color x:Key="SuccessColor">#FF00C982</Color>
    <Color x:Key="SuccessInkColor">#FF006E49</Color>
    <Color x:Key="TextMutedColor">#FF696962</Color>
    <Color x:Key="LineColor">#FFD0D0C9</Color>
    <Color x:Key="LineStrongColor">#FFA6A69D</Color>

    <!-- Semantic brush tokens -->
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkRaisedBrush" Color="{StaticResource InkRaisedColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="PaperElevatedBrush" Color="{StaticResource PaperElevatedColor}" />
    <SolidColorBrush x:Key="PaperMutedBrush" Color="{StaticResource PaperMutedColor}" />
    <SolidColorBrush x:Key="PaperPressedBrush" Color="{StaticResource PaperPressedColor}" />
    <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SignalPressedBrush" Color="{StaticResource SignalPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessInkBrush" Color="{StaticResource SuccessInkColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8191919" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="#B8F2F2F0" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="Ink05Brush" Color="#0D191919" />
    <SolidColorBrush x:Key="Ink08Brush" Color="#14191919" />
    <SolidColorBrush x:Key="Ink12Brush" Color="#1F191919" />
    <SolidColorBrush x:Key="Ink18Brush" Color="#2E191919" />
    <SolidColorBrush x:Key="Ink42Brush" Color="#6B191919" />
    <SolidColorBrush x:Key="Paper08Brush" Color="#14F2F2F0" />
    <SolidColorBrush x:Key="Paper14Brush" Color="#24F2F2F0" />
    <SolidColorBrush x:Key="Paper24Brush" Color="#3DF2F2F0" />
    <SolidColorBrush x:Key="Signal18Brush" Color="#2EFFFA00" />
    <SolidColorBrush x:Key="Signal32Brush" Color="#52FFFA00" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1F00C982" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#5C696962" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A6191919" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#4D000000" />

    <!-- Common semantic aliases make view XAML read by purpose. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource PaperElevatedColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="VerifiedBrush" Color="{StaticResource SuccessColor}" />

    <!-- Original low-opacity engineering textures; no external assets. -->
    <DrawingBrush x:Key="EngineeringGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,64,64"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,64,64"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 L 64,0 M 0,0 L 0,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Ink08Brush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Ink12Brush}" Geometry="M 0,0 L 3,0 3,3 0,3 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="DarkEngineeringGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,64,64"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,64,64"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 L 64,0 M 0,0 L 0,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Paper08Brush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Signal32Brush}" Geometry="M 0,0 L 3,0 3,3 0,3 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Type, spacing, geometry, and motion tokens -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="TechnicalFontFamily">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">16</sys:Double>
    <sys:Double x:Key="FontSizeSection">32</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">48</sys:Double>
    <sys:Double x:Key="FontSizeHero">72</sys:Double>

    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space40">40</Thickness>
    <Thickness x:Key="PanelPadding">24</Thickness>
    <Thickness x:Key="PagePadding">32,28,36,32</Thickness>

    <CornerRadius x:Key="ActionCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="CompactActionCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>

    <CubicEase x:Key="DirectEaseOut" EasingMode="EaseOut" />
    <CubicEase x:Key="DirectEaseInOut" EasingMode="EaseInOut" />
    <QuinticEase x:Key="RevealEaseOut" EasingMode="EaseOut" />

    <DropShadowEffect x:Key="ButtonShadow"
                      BlurRadius="18"
                      Direction="270"
                      Opacity="0.18"
                      RenderingBias="Performance"
                      ShadowDepth="4"
                      Color="#FF000000" />
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="24"
                      Direction="270"
                      Opacity="0.12"
                      RenderingBias="Performance"
                      ShadowDepth="6"
                      Color="#FF000000" />

    <!-- Keyboard focus -->
    <Style x:Key="FocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource SignalBrush}"
                            BorderThickness="2"
                            CornerRadius="16"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded direct-action buttons -->
    <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="{x:Type Button}">
        <Grid x:Name="Root"
              Background="Transparent"
              RenderTransformOrigin="0.5,0.5"
              SnapsToDevicePixels="True">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="ButtonShift" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border x:Name="Chrome"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource ActionCornerRadius}"
                    Effect="{TemplateBinding Effect}" />

            <Border x:Name="HoverWash"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{StaticResource ActionCornerRadius}"
                    IsHitTestVisible="False"
                    Opacity="0" />

            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverWash"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.20"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1"
                                             Duration="0:0:0.20"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1"
                                             Duration="0:0:0.20"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                             Storyboard.TargetProperty="Y"
                                             To="0"
                                             Duration="0:0:0.20"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverWash"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.22"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1"
                                             Duration="0:0:0.22"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1"
                                             Duration="0:0:0.22"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                             Storyboard.TargetProperty="Y"
                                             To="0"
                                             Duration="0:0:0.22"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverWash"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.18"
                                             Duration="0:0:0.18" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="0.975"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="0.975"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                             Storyboard.TargetProperty="Y"
                                             To="1"
                                             Duration="0:0:0.18"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverWash"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.10"
                                             Duration="0:0:0.24"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.015"
                                             Duration="0:0:0.24"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.015"
                                             Duration="0:0:0.24"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                            <DoubleAnimation Storyboard.TargetName="ButtonShift"
                                             Storyboard.TargetProperty="Y"
                                             To="-1"
                                             Duration="0:0:0.24"
                                             EasingFunction="{StaticResource DirectEaseOut}" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.42" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="EndfieldButtonBase" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
    </Style>

    <Style x:Key="PrimaryButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        <Setter Property="MinWidth" Value="116" />
    </Style>

    <Style x:Key="SecondaryButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
        <Setter Property="MinWidth" Value="104" />
    </Style>

    <Style x:Key="GhostButton"
           BasedOn="{StaticResource EndfieldButtonBase}"
           TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <Style x:Key="IconButton"
           BasedOn="{StaticResource GhostButton}"
           TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Navigation keeps a rounded touch target and a hard signal rail. -->
    <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="16,0,14,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="NavRoot"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="NavShift" X="0" />
                        </Grid.RenderTransform>
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CompactActionCornerRadius}" />
                        <Border x:Name="NavHover"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource CompactActionCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="NavMarker"
                                Width="3"
                                Height="24"
                                Margin="0,0,3,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SignalBrush}"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08"
                                                         Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="NavShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavHover"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="NavShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavHover" Property="Opacity" Value="0.16" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="1"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="NavShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="3"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="NavMarker" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="NavMarker" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavRoot" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Media/content cards: rounded interaction, rectilinear information. -->
    <Style x:Key="CardButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource PaperElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{StaticResource CardShadow}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="CardRoot"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CardShift" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="CardHoverWash"
                                Background="{DynamicResource InkBrush}"
                                CornerRadius="{StaticResource CardCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="CardSignalRule"
                                Height="4"
                                Margin="18,0,18,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource SignalBrush}"
                                IsHitTestVisible="False"
                                Opacity="0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="CardRuleShift" X="-24" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.035"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardSignalRule"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.22" />
                                        <DoubleAnimation Storyboard.TargetName="CardRuleShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="0:0:0.30"
                                                         EasingFunction="{StaticResource RevealEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardHoverWash"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.24" />
                                        <DoubleAnimation Storyboard.TargetName="CardSignalRule"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="CardRuleShift"
                                                         Storyboard.TargetProperty="X"
                                                         To="-24"
                                                         Duration="0:0:0.20" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1"
                                                         Duration="0:0:0.26"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1"
                                                         Duration="0:0:0.26"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="0:0:0.26"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardHoverWash" Property="Opacity" Value="0.07" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.99"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.99"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.012"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.012"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="CardShift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-3"
                                                         Duration="0:0:0.24"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CardRoot" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text input -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{DynamicResource PaperElevatedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SignalBrush}" />
        <Setter Property="SelectionOpacity" Value="0.72" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid x:Name="InputRoot" Background="Transparent">
                        <Border x:Name="InputChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource CompactActionCornerRadius}" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center" />
                        <Border x:Name="InputIndicator"
                                Width="3"
                                Height="20"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SignalBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="InputFocusRing"
                                Margin="-2"
                                BorderBrush="{DynamicResource SignalBrush}"
                                BorderThickness="2"
                                CornerRadius="14"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InputIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.35"
                                                         Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InputIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="InputChrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InputIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="InputFocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.20"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="InputIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                        <DoubleAnimation Storyboard.TargetName="InputFocusRing"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="InputRoot" Property="Opacity" Value="0.46" />
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="InputChrome" Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PathTextBox"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource TechnicalFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Search is an action-first field instrument: icon and live match state
         are composed by the view, while this style preserves the shared signal
         focus rail and readable keyboard focus treatment. -->
    <Style x:Key="SearchTextBox"
           BasedOn="{StaticResource {x:Type TextBox}}"
           TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="Padding" Value="46,0,154,0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- Scroll bars -->
    <Style x:Key="EndfieldScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Opacity="0.56" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbChrome"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.86"
                                                         Duration="0:0:0.18"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard HandoffBehavior="SnapshotAndReplace">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbChrome"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.56"
                                                         Duration="0:0:0.22"
                                                         EasingFunction="{StaticResource DirectEaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Opacity" Value="1" />
                            <Setter TargetName="ThumbChrome" Property="Background" Value="{DynamicResource SignalBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Width="14" Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   Margin="3,0"
                   IsDirectionReversed="True"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Vertical"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EndfieldScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Height="14" Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track"
                   Margin="0,3"
                   IsDirectionReversed="False"
                   Maximum="{TemplateBinding Maximum}"
                   Minimum="{TemplateBinding Minimum}"
                   Orientation="Horizontal"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource EndfieldScrollThumb}" MinWidth="28" MinHeight="8" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}"
                                  Style="{StaticResource ScrollPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tooltips -->
    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Paper24Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panels and status -->
    <Style x:Key="LightPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PaperElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DarkPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource PanelPadding}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatusPill" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource Ink08Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ink18Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{StaticResource TechnicalFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="11" />
    </Style>

    <Style x:Key="SuccessStatusPill"
           BasedOn="{StaticResource StatusPill}"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessInkBrush}" />
    </Style>

    <Style x:Key="PreviewFrame" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource PaperMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SignalDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="RuleDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Typography -->
    <Style x:Key="TechnicalLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource TechnicalFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TechnicalLabelOnDark"
           BasedOn="{StaticResource TechnicalLabel}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}" />
        <Setter Property="FontStretch" Value="SemiCondensed" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="LineHeight" Value="35" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageTitle"
           BasedOn="{StaticResource SectionTitle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="LineHeight" Value="49" />
    </Style>

    <Style x:Key="HeroNumeral"
           BasedOn="{StaticResource SectionTitle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHero}" />
        <Setter Property="LineHeight" Value="70" />
        <Setter Property="Foreground" Value="{DynamicResource Ink12Brush}" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedText"
           BasedOn="{StaticResource BodyText}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="PanelHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodyLarge}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardTitle"
           BasedOn="{StaticResource PanelHeader}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="WordEllipsis" />
        <Setter Property="MaxHeight" Value="42" />
    </Style>

    <Style x:Key="NoInformationText"
           BasedOn="{StaticResource TechnicalLabel}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Determinate task progress uses the family signal; green remains reserved for verified state. -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource SignalBrush}" />
        <Setter Property="Background" Value="#38FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="PART_Track" ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Width" Value="72" />
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
