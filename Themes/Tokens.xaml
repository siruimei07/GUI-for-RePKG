<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- v1.4 terminal-light palette: paper workspace, near-black edge dock, one cyan signal,
         acid lime reserved for ready/verified state, amber and red for problems. -->
    <!-- Core color tokens. Ink is the dark dock family; Paper is the light family used as text on Ink. -->
    <Color x:Key="InkColor">#FF17191C</Color>
    <Color x:Key="InkRaisedColor">#FF23272B</Color>
    <Color x:Key="InkSoftColor">#FF30363B</Color>
    <Color x:Key="PaperColor">#FFF4F6F7</Color>
    <Color x:Key="PaperElevatedColor">#FFFFFFFF</Color>
    <Color x:Key="PaperMutedColor">#FFE3E8EB</Color>
    <Color x:Key="PaperPressedColor">#FFD3DADE</Color>
    <Color x:Key="SignalColor">#FF18D1FF</Color>
    <Color x:Key="SignalPressedColor">#FF0090C0</Color>
    <Color x:Key="SuccessColor">#FFC8EB21</Color>
    <Color x:Key="SuccessInkColor">#FF223000</Color>
    <Color x:Key="TextMutedColor">#FF59636A</Color>
    <Color x:Key="LineColor">#FFD5DBDF</Color>
    <Color x:Key="LineStrongColor">#FF86919A</Color>

    <!-- Semantic brush tokens -->
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="InkRaisedBrush" Color="{StaticResource InkRaisedColor}" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="{StaticResource InkSoftColor}" />
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="PaperElevatedBrush" Color="{StaticResource PaperElevatedColor}" />
    <SolidColorBrush x:Key="PaperMutedBrush" Color="{StaticResource PaperMutedColor}" />
    <SolidColorBrush x:Key="PaperPressedBrush" Color="{StaticResource PaperPressedColor}" />
    <SolidColorBrush x:Key="SignalBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SignalPressedBrush" Color="{StaticResource SignalPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessInkBrush" Color="{StaticResource SuccessInkColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF3A4349" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnDarkMutedBrush" Color="#FFA9B3B9" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="Ink05Brush" Color="#0D17191C" />
    <SolidColorBrush x:Key="Ink08Brush" Color="#1417191C" />
    <SolidColorBrush x:Key="Ink12Brush" Color="#1F17191C" />
    <SolidColorBrush x:Key="Ink18Brush" Color="#2E17191C" />
    <SolidColorBrush x:Key="Ink42Brush" Color="#6B17191C" />
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#8C17191C" />
    <SolidColorBrush x:Key="Paper08Brush" Color="#14F4F6F7" />
    <SolidColorBrush x:Key="Paper14Brush" Color="#24F4F6F7" />
    <SolidColorBrush x:Key="Paper24Brush" Color="#3DF4F6F7" />
    <SolidColorBrush x:Key="Signal18Brush" Color="#2E18D1FF" />
    <SolidColorBrush x:Key="Signal32Brush" Color="#5218D1FF" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#33C8EB21" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#FF8E979D" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#D917191C" />
    <SolidColorBrush x:Key="ShadowBrush" Color="#2917191C" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FF0B0D0F" />
    <SolidColorBrush x:Key="SignalTextBrush" Color="#FF0B0D0F" />
    <SolidColorBrush x:Key="FocusOuterBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="FocusInnerBrush" Color="{StaticResource SignalColor}" />

    <!-- Common semantic aliases make view XAML read by purpose. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFECEFF1" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource PaperElevatedColor}" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="VerifiedBrush" Color="{StaticResource SuccessColor}" />

    <!-- Surfaces and text are distinct so High Contrast can replace each by purpose. -->
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#FFF5F7F8" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#FFE3E8EB" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentActionBrush" Color="{StaticResource SignalColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FF006E99" />

    <!-- Problem semantics and instrument surfaces introduced with the light terminal. -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB020" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FF8A4F00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FFB3261E" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#FFDCE3E7" />
    <SolidColorBrush x:Key="DecorationLineBrush" Color="#2617191C" />
    <SolidColorBrush x:Key="DecorationFillBrush" Color="#0F17191C" />
    <SolidColorBrush x:Key="DockRuleBrush" Color="#FF30363B" />

    <!-- Quiet blueprint grid for the workspace stage. Its drift is owned by MainWindow motion. -->
    <DrawingBrush x:Key="EngineeringGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,56,56"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,56,56"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="M 0,0 L 56,0 56,56 0,56 Z" />
                <GeometryDrawing Geometry="M 0,0 L 56,0 M 0,0 L 0,56">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#1417191C" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#3317191C" Geometry="M 0,0 L 2,0 2,2 0,2 Z M 28,28 L 29,28 29,29 28,29 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
        <DrawingBrush.Transform>
            <TranslateTransform />
        </DrawingBrush.Transform>
    </DrawingBrush>

    <DrawingBrush x:Key="DarkEngineeringGridBrush"
                  TileMode="Tile"
                  Viewport="0,0,64,64"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,64,64"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="M 0,0 L 64,0 M 0,0 L 0,64">
                    <GeometryDrawing.Pen>
                        <Pen Brush="{StaticResource Paper08Brush}" Thickness="1" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource Signal32Brush}" Geometry="M 0,0 L 3,0 3,3 0,3 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Diagonal hazard stripes used sparingly as an edge cue on busy/attention instruments. -->
    <DrawingBrush x:Key="HazardStripeBrush"
                  TileMode="Tile"
                  Viewport="0,0,12,12"
                  ViewportUnits="Absolute"
                  Viewbox="0,0,12,12"
                  ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF17191C" Geometry="M 0,0 L 12,0 12,12 0,12 Z" />
                <GeometryDrawing Brush="#FF18D1FF" Geometry="M 0,12 L 6,12 12,6 12,0 Z M 0,0 L 0,6 6,0 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
        <DrawingBrush.Transform>
            <TranslateTransform />
        </DrawingBrush.Transform>
    </DrawingBrush>

    <!-- Type, spacing, geometry, and motion tokens -->
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Bahnschrift SemiCondensed, Bahnschrift, Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="TechnicalFontFamily">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="LabelFontFamily">Bahnschrift, Microsoft YaHei UI, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons ships with Windows 11; Segoe MDL2 Assets keeps the same glyphs on Windows 10. -->
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeMicro">10</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeBodyLarge">15</sys:Double>
    <sys:Double x:Key="FontSizeSection">26</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">32</sys:Double>
    <sys:Double x:Key="FontSizeHero">56</sys:Double>

    <Thickness x:Key="Space4">4</Thickness>
    <Thickness x:Key="Space8">8</Thickness>
    <Thickness x:Key="Space12">12</Thickness>
    <Thickness x:Key="Space16">16</Thickness>
    <Thickness x:Key="Space20">20</Thickness>
    <Thickness x:Key="Space24">24</Thickness>
    <Thickness x:Key="Space32">32</Thickness>
    <Thickness x:Key="Space40">40</Thickness>
    <Thickness x:Key="PanelPadding">16</Thickness>
    <Thickness x:Key="PagePadding">20,16,20,16</Thickness>
    <sys:Double x:Key="ComfortableCardHeight">138</sys:Double>
    <sys:Double x:Key="CompactCardHeight">104</sys:Double>
    <sys:Double x:Key="BrowseCardMinimumWidth">104</sys:Double>
    <sys:Double x:Key="BrowseProcessingTrayHeight">72</sys:Double>
    <GridLength x:Key="BrowseProcessingTrayGridLength">72</GridLength>
    <GridLength x:Key="ComfortableCardPreviewWidth">236</GridLength>
    <GridLength x:Key="CompactCardPreviewWidth">168</GridLength>
    <Thickness x:Key="ComfortableCardMargin">0,0,4,8</Thickness>
    <Thickness x:Key="CompactCardMargin">0,0,4,6</Thickness>

    <!-- Square industrial geometry; corners carry meaning through cut markers, not radius. -->
    <CornerRadius x:Key="ActionCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CompactActionCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">0</CornerRadius>

    <DropShadowEffect x:Key="ButtonShadow"
                      BlurRadius="18"
                      Direction="270"
                      Opacity="0"
                      RenderingBias="Performance"
                      ShadowDepth="4"
                      Color="#FF000000" />
    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="24"
                      Direction="270"
                      Opacity="0"
                      RenderingBias="Performance"
                      ShadowDepth="6"
                      Color="#FF000000" />

</ResourceDictionary>
