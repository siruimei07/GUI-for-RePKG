<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:WallpaperField.Controls">

    <!-- Navigation, cards, panels, status, typography, and problem presentation. -->
    <!-- Dock navigation: dark rail, paper active slab, cyan index marker, lateral hover drift. -->
    <Style x:Key="NavButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="12,0,10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:MotionAssist.Hover" Value="Slide" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="NavRoot"
                          Background="Transparent">
                        <Border x:Name="NavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CompactActionCornerRadius}" />
                        <Border x:Name="NavHover"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{DynamicResource CompactActionCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="NavMarker"
                                Width="4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentActionBrush}"
                                Opacity="0" />
                        <Path x:Name="NavCorner"
                              Width="8"
                              Height="8"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 8,0 8,8 Z"
                              Fill="{DynamicResource AccentActionBrush}"
                              IsHitTestVisible="False"
                              Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavHover" Property="Opacity" Value="0.08" />
                            <Setter TargetName="NavMarker" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NavHover" Property="Opacity" Value="0.16" />
                        </Trigger>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NavMarker" Property="Opacity" Value="1" />
                            <Setter TargetName="NavCorner" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NavHover" Property="Opacity" Value="0" />
                            <Setter TargetName="NavMarker" Property="Opacity" Value="1" />
                            <Setter TargetName="NavCorner" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NavRoot" Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Media/content cards: square paper record with a cyan signal rule on hover. -->
    <Style x:Key="CardButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="180" />
        <Setter Property="MinHeight" Value="200" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="controls:MotionAssist.Hover" Value="Lift" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid x:Name="CardRoot"
                          Background="Transparent">
                        <Border x:Name="CardChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                Effect="{TemplateBinding Effect}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="CardHoverWash"
                                Background="{DynamicResource InkBrush}"
                                CornerRadius="{DynamicResource CardCornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="CardSignalRule"
                                Height="3"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource AccentActionBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Path x:Name="CardCorner"
                              Width="10"
                              Height="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 10,0 10,10 Z"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              IsHitTestVisible="False"
                              Opacity="0.85" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardChrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter TargetName="CardHoverWash" Property="Opacity" Value="0.03" />
                            <Setter TargetName="CardSignalRule" Property="Opacity" Value="1" />
                            <Setter TargetName="CardCorner" Property="Fill" Value="{DynamicResource AccentActionBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardHoverWash" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CardRoot" Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrowseProjectCardButton" TargetType="{x:Type Button}">
        <Setter Property="MinWidth" Value="{DynamicResource BrowseCardMinimumWidth}" />
        <Setter Property="MinHeight" Value="104" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="BrowseCardChrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0"
                            ClipToBounds="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BrowseCardChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="BrowseCardChrome"
                                    Property="BorderBrush"
                                    Value="{DynamicResource SignalPressedBrush}" />
                            <Setter TargetName="BrowseCardChrome"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.54" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panels and status -->
    <Style x:Key="LightPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Instrument panel: paper slab with an ink spine; views add the cut-corner marker. -->
    <Style x:Key="InstrumentPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="4,1,1,1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="DarkPanel" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InkSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource PanelPadding}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="StatusPill" TargetType="{x:Type Border}">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource PillCornerRadius}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource LabelFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SuccessStatusPill"
           BasedOn="{StaticResource StatusPill}"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessInkBrush}" />
    </Style>

    <Style x:Key="WarningStatusPill"
           BasedOn="{StaticResource StatusPill}"
           TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource SignalTextBrush}" />
    </Style>

    <Style x:Key="PreviewFrame" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SignalDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="2" />
        <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="RuleDivider" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Typography -->
    <Style x:Key="TechnicalLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource LabelFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TechnicalLabelOnDark"
           BasedOn="{StaticResource TechnicalLabel}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextOnDarkMutedBrush}" />
    </Style>

    <!-- Section index chip: "01" in a solid ink block, the recurring page coordinate. -->
    <Style x:Key="IndexChip" TargetType="{x:Type Border}">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Background" Value="{DynamicResource InkBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource PaperBrush}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource LabelFontFamily}" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="32" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageTitle"
           BasedOn="{StaticResource SectionTitle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style x:Key="HeroNumeral"
           BasedOn="{StaticResource SectionTitle}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeHero}" />
        <Setter Property="LineHeight" Value="56" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Oversized page coordinate printed into the stage; decoration only, never read by AT. -->
    <Style x:Key="StageWatermark" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="132" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource DecorationFillBrush}" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Large tabular readout used by the page stat blocks. -->
    <Style x:Key="StatReadout" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Typography.NumeralStyle" Value="Lining" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="BodyText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MutedText"
           BasedOn="{StaticResource BodyText}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style x:Key="PanelHeader" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodyLarge}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CardTitle"
           BasedOn="{StaticResource PanelHeader}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="WordEllipsis" />
        <Setter Property="MaxHeight" Value="42" />
    </Style>

    <Style x:Key="NoInformationText"
           BasedOn="{StaticResource TechnicalLabel}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Problem filtering and shared wallpaper-card presentation. -->
    <Style x:Key="ProblemFilterComboBoxItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Grid>
                        <Border x:Name="ItemChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                CornerRadius="0">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="ItemMarker"
                                Width="3"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TextPrimaryBrush}"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                            <Setter TargetName="ItemMarker" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource AccentActionBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ProblemFilterComboBox" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,0,40,0" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ProblemFilterComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton x:Name="DropDownToggle"
                                      Padding="{TemplateBinding Padding}"
                                      Background="{TemplateBinding Background}"
                                      Foreground="{TemplateBinding Foreground}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="ComboChrome"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0">
                                        <Grid>
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            <Border Width="30"
                                                    HorizontalAlignment="Right"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1,0,0,0">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource IconFontFamily}"
                                                           FontSize="11"
                                                           Text="&#xE70D;" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{DynamicResource SignalPressedBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom"
                               PopupAnimation="None">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="330"
                                    Margin="0,4,0,0"
                                    Padding="4"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="1,3,1,1"
                                    CornerRadius="0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DropDownToggle" Property="Opacity" Value="0.46" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="WallpaperCardTemplate">
        <Button x:Name="WallpaperCardButton"
                Height="{DynamicResource ComfortableCardHeight}"
                MinHeight="0"
                Margin="{DynamicResource ComfortableCardMargin}"
                Padding="0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Style="{StaticResource CardButton}"
                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                CommandParameter="{Binding}"
                AutomationProperties.Name="{Binding Title, StringFormat=打开项目目录：{0}}"
                ToolTip="打开已有输出目录；尚未解包时打开源目录">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CardPreviewColumn"
                                      Width="{DynamicResource ComfortableCardPreviewWidth}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="66" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource InkSoftBrush}"
                        ClipToBounds="True"
                        CornerRadius="0">
                    <Grid>
                        <controls:AnimatedPreviewImage SourcePath="{Binding PreviewPath}"
                                                       AnimationEnabled="{Binding MotionEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       DecodePixelWidth="480"
                                                       Stretch="UniformToFill"
                                                       Panel.ZIndex="1"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       AutomationProperties.Name="{Binding Title, StringFormat=壁纸预览：{0}}">
                            <controls:AnimatedPreviewImage.Style>
                                <Style TargetType="{x:Type controls:AnimatedPreviewImage}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </controls:AnimatedPreviewImage.Style>
                        </controls:AnimatedPreviewImage>

                        <Grid Panel.ZIndex="0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="27"
                                           Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Text="&#xE91B;" />
                                <TextBlock x:Name="CardPreviewEmptyLabel"
                                           Margin="0,9,0,0"
                                           Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Text="无信息" />
                            </StackPanel>
                        </Grid>

                        <Border Height="24"
                                Padding="8,0"
                                VerticalAlignment="Top"
                                HorizontalAlignment="Left"
                                Panel.ZIndex="2"
                                Background="{DynamicResource OverlayBrush}"
                                CornerRadius="0">
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="{DynamicResource LabelFontFamily}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PaperBrush}"
                                       Text="{Binding WorkshopId, StringFormat=ID / {0}}" />
                        </Border>

                        <Border Margin="0,8,8,0"
                                Padding="7,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="2"
                                Background="{DynamicResource WarningBrush}"
                                CornerRadius="0"
                                ToolTip="{Binding WarningSummary}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="Black"
                                           Foreground="{DynamicResource SignalTextBrush}"
                                           Text="!" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource LabelFontFamily}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SignalTextBrush}"
                                           Text="{Binding WarningCount}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="8,0,0,8"
                                Padding="7,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Panel.ZIndex="2"
                                CornerRadius="0"
                                ToolTip="{Binding PackageStatusDetail}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnpackableContent}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUnpackableContent}" Value="True">
                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessInkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource IconFontFamily}"
                                           FontSize="10"
                                           Text="&#xE7C5;" />
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{DynamicResource LabelFontFamily}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Text="{Binding PackageStatus}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid x:Name="CardContentGrid" Grid.Column="1" Margin="20,16,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CardTechnicalHeader"
                               Grid.Row="0"
                               Style="{StaticResource TechnicalLabel}"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Text="WALLPAPER / PACKAGE RECORD" />
                    <TextBlock x:Name="CardTitle"
                               Grid.Row="1"
                               Margin="0,7,0,5"
                               VerticalAlignment="Top"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                    <Grid x:Name="CardMetadataGrid" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,0,0"
                                Padding="8,0,0,0"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="2,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource TechnicalLabel}"
                                           Text="SOURCE FOLDER" />
                                <TextBlock Margin="0,3,0,0"
                                           FontFamily="{DynamicResource TechnicalFontFamily}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding FolderName}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource TechnicalLabel}"
                                       Text="UNPACK STATE" />
                            <TextBlock Margin="0,3,0,0"
                                       HorizontalAlignment="Right"
                                       FontFamily="{DynamicResource LabelFontFamily}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Text="{Binding PackageStatus}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Column="2"
                        Width="38"
                        Height="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource InkBrush}"
                        CornerRadius="0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsUnpackSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource IconFontFamily}"
                               FontSize="13"
                               Foreground="{DynamicResource PaperBrush}"
                               Text="&#xE72A;" />
                </Border>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding DataContext.Density, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="Compact">
                <Setter TargetName="WallpaperCardButton"
                        Property="Height"
                        Value="{DynamicResource CompactCardHeight}" />
                <Setter TargetName="WallpaperCardButton"
                        Property="Margin"
                        Value="{DynamicResource CompactCardMargin}" />
                <Setter TargetName="CardPreviewColumn"
                        Property="Width"
                        Value="{DynamicResource CompactCardPreviewWidth}" />
                <Setter TargetName="CardContentGrid" Property="Margin" Value="16,13,14,12" />
                <Setter TargetName="CardTechnicalHeader" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CardMetadataGrid" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CardPreviewEmptyLabel" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="CardTitle" Property="Margin" Value="0" />
                <Setter TargetName="CardTitle" Property="FontSize" Value="16" />
                <Setter TargetName="CardTitle" Property="VerticalAlignment" Value="Center" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
