<UserControl x:Class="FieldStation.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FieldStation.Controls">
    <Grid x:Name="PageRoot" Margin="28,22,34,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="VERIFIED REPORT / 04" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="运行报告" Foreground="{StaticResource PaperBrush}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" Width="150" Padding="9" FontFamily="{StaticResource MonoFont}" FontSize="9" VerticalAlignment="Center" /></Grid>

        <!-- Report mode uses editorial paper as primary content owner, not a dark HUD. -->
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.62*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PaperPanel}" ClipToBounds="True">
                <Grid Margin="24,21"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="54" /></Grid.RowDefinitions>
                    <DockPanel><StackPanel><TextBlock Text="THROUGHPUT / VERIFIED VALUES" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="近七日输出效率" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="31" FontWeight="Black" Margin="0,5,0,0" /></StackPanel><TextBlock Text="04" Foreground="#15000000" FontFamily="{StaticResource DisplayFont}" FontSize="70" FontWeight="Black" HorizontalAlignment="Right" /></DockPanel>
                    <Grid Grid.Row="1" Margin="0,22,0,8"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="1" /></Grid.RowDefinitions>
                        <Rectangle Fill="#08000000" /><Rectangle Fill="#09000000" Margin="0,62,0,62" />
                        <ItemsControl ItemsSource="{Binding Bars}" VerticalAlignment="Bottom" Height="245">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="9,0"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="25" /></Grid.RowDefinitions><Grid Height="220" VerticalAlignment="Bottom"><Rectangle Width="42" Height="{Binding Height}" Fill="{StaticResource InkBrush}" VerticalAlignment="Bottom" /><Canvas Width="42" Height="220" HorizontalAlignment="Center"><Rectangle Canvas.Top="{Binding TargetPosition}" Width="42" Height="3" Fill="{StaticResource SignalBrush}" /></Canvas><TextBlock Text="{Binding Value}" Foreground="{StaticResource PaperBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,7" /></Grid><TextBlock Grid.Row="1" Text="{Binding Label}" Foreground="#88000000" Style="{StaticResource MicroLabel}" HorizontalAlignment="Center" VerticalAlignment="Bottom" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Rectangle Grid.Row="1" Fill="{StaticResource InkBrush}" />
                    </Grid>
                    <DockPanel Grid.Row="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Rectangle Width="18" Height="4" Fill="{StaticResource InkBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="ACTUAL" Foreground="#88000000" Style="{StaticResource MicroLabel}" /><Rectangle Width="18" Height="4" Fill="{StaticResource SignalBrush}" Margin="22,0,7,0" VerticalAlignment="Center" /><TextBlock Text="TARGET" Foreground="#88000000" Style="{StaticResource MicroLabel}" /></StackPanel><TextBlock Text="REPORT OWNS NARRATIVE / DOSSIER OWNS SUMMARY" Foreground="#66000000" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="1.05*" /><RowDefinition Height="14" /><RowDefinition Height="0.72*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource DarkPanel}" Padding="20"><Grid><TextBlock Text="04" Foreground="#0EFFFFFF" FontFamily="{StaticResource DisplayFont}" FontSize="160" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-45" /><StackPanel><TextBlock Text="STATUS DOSSIER" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="指标摘要" Foreground="{StaticResource PaperBrush}" FontSize="22" FontWeight="Bold" Margin="0,4,0,19" /><TextBlock Text="AVERAGE" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding Average}" Foreground="{StaticResource PaperBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="Black" /><Rectangle Height="1" Fill="{StaticResource White14Brush}" Margin="0,12" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PEAK" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding Peak}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Black" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TARGET RATE" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding TargetRate}" Foreground="{StaticResource PaperBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Black" /></StackPanel></Grid></StackPanel></Grid></Border>
                <Border Grid.Row="2" Style="{StaticResource DarkPanel}" Padding="13"><controls:RegionHost RegionKey="reports.annotation" Title="报告注释与行动" Description="挂载审批、导出、解释或下游动作。" /></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
