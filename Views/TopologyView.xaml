<UserControl x:Class="FieldStation.Views.TopologyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FieldStation.Controls">
    <Grid x:Name="PageRoot" Margin="28,22,34,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ROUTE MATRIX / 02" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="拓扑调度" Foreground="{StaticResource PaperBrush}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="GRAPH OWNS CHOICES" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /><TextBlock Text="SELECT A NODE TO INSPECT" Foreground="{StaticResource OnlineBrush}" Style="{StaticResource MicroLabel}" Margin="0,5,0,0" /></StackPanel></Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <!-- Exploration mode: one uninterrupted route graph. -->
            <Border Style="{StaticResource DarkPanel}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="02" Foreground="#08FFFFFF" FontFamily="{StaticResource DisplayFont}" FontSize="260" FontWeight="Black" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-15,0,0,-65" />
                    <Viewbox Stretch="Uniform" Margin="20">
                        <Canvas Width="900" Height="520">
                            <Path Data="M135,285 L330,140 L495,350 L695,170 L800,385" Stroke="#3BFFFFFF" StrokeThickness="2" Fill="Transparent" />
                            <Path Data="M135,285 L495,350 L800,385" Stroke="{StaticResource SignalBrush}" StrokeThickness="3" Fill="Transparent" StrokeDashArray="4 8" />
                            <Ellipse Canvas.Left="380" Canvas.Top="105" Width="360" Height="360" Stroke="#18FFFFFF" StrokeThickness="1" />
                            <Ellipse Canvas.Left="430" Canvas.Top="155" Width="260" Height="260" Stroke="#12FFFFFF" StrokeThickness="1" />
                            <Line X1="610" Y1="0" X2="610" Y2="520" Stroke="#13FFFFFF" StrokeThickness="1" />
                            <Line X1="0" Y1="285" X2="900" Y2="285" Stroke="#13FFFFFF" StrokeThickness="1" />

                            <ListBox ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                     Width="900" Height="520" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" /><Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="Width" Value="112" /><Setter Property="Height" Value="72" /><Setter Property="Padding" Value="0" />
                                        <Setter Property="Background" Value="#E6191919" /><Setter Property="BorderBrush" Value="#55FFFFFF" /><Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NodeRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NodeRoot" Property="BorderBrush" Value="White" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="NodeRoot" Property="Background" Value="{StaticResource SignalBrush}" /><Setter Property="Foreground" Value="{StaticResource InkBrush}" /><Setter TargetName="NodeRoot" Property="BorderBrush" Value="{StaticResource SignalBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NodeRoot" Property="BorderThickness" Value="3" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="10,8"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding Id}" FontFamily="{StaticResource MonoFont}" FontSize="8" /><TextBlock Text="{Binding Kind}" FontFamily="{StaticResource MonoFont}" FontSize="7" HorizontalAlignment="Right" /></DockPanel><TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Row="2" Text="{Binding Status}" FontFamily="{StaticResource MonoFont}" FontSize="8" /></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Canvas>
                    </Viewbox>
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,20"><TextBlock Text="LIVE ROUTE" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="节点 → 中继 → 输出" Foreground="{StaticResource White76Brush}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PaperPanel}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="7" /><RowDefinition Height="Auto" /><RowDefinition Height="1" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Rectangle Fill="{StaticResource SignalBrush}" />
                    <StackPanel Grid.Row="1" Margin="19,18"><DockPanel><TextBlock Text="NODE DOSSIER" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedNode.Id}" Foreground="#33000000" FontFamily="{StaticResource DisplayFont}" FontSize="31" FontWeight="Black" HorizontalAlignment="Right" /></DockPanel><TextBlock Text="{Binding SelectedNode.Name, TargetNullValue=未选择节点}" Foreground="{StaticResource InkBrush}" FontSize="23" FontWeight="Bold" Margin="0,17,0,0" /><TextBlock Text="{Binding SelectedNode.Detail}" Foreground="#A0000000" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" /></StackPanel>
                    <Rectangle Grid.Row="2" Fill="{StaticResource Black10Brush}" />
                    <Grid Grid.Row="3" Margin="19,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CAPACITY" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedNode.Capacity}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="Black" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="CURRENT LOAD" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedNode.Load}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="27" FontWeight="Black" Margin="0,4,0,0" /></StackPanel></Grid>
                    <Border Grid.Row="4" Background="{StaticResource InkBrush}" Margin="14,0,14,14" Padding="13"><controls:RegionHost RegionKey="topology.detail" Title="节点附件" Description="挂载诊断、参数编辑或领域操作。" /></Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
