<UserControl x:Class="FieldStation.Views.CommandCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FieldStation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageRoot" Margin="28,22,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="380" />
                <RowDefinition Height="14" /><RowDefinition Height="126" /><RowDefinition Height="14" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="FIELD COMMAND / 01" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="总控工作台" Foreground="{StaticResource PaperBrush}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="CURRENT WORKSPACE" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /><TextBlock Text="{Binding WorkspaceName}" Foreground="{StaticResource OnlineBrush}" Style="{StaticResource MicroLabel}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right" /></StackPanel>
            </Grid>

            <!-- Construction mode receives a bespoke action-first stage. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.65*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.72*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DarkPanel}" ClipToBounds="True">
                    <Grid>
                        <TextBlock Text="01" Foreground="#09FFFFFF" FontFamily="{StaticResource DisplayFont}" FontSize="280" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-22,-72" />
                        <Path Data="M460,-20 L760,-20 L520,410 L220,410 Z" Fill="#08FFFFFF" HorizontalAlignment="Right" Stretch="None" />
                        <Ellipse Width="290" Height="290" Stroke="#1CFFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,52,0" />
                        <Ellipse Width="205" Height="205" Stroke="#16FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,95,0" />
                        <Line X1="0" Y1="0" X2="240" Y2="0" Stroke="{StaticResource SignalBrush}" StrokeThickness="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0" RenderTransformOrigin="0.5,0.5"><Line.RenderTransform><RotateTransform Angle="-31" /></Line.RenderTransform></Line>
                        <Grid Margin="29,25,29,24">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel><TextBlock Text="PRIMARY DECISION" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding Mode}" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel>
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="600">
                                <TextBlock Text="构筑 / 调度" Foreground="{StaticResource PaperBrush}" Style="{StaticResource HeroTitle}" />
                                <TextBlock Text="MODULAR OPERATIONS STATION" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="2,10,0,0" />
                                <TextBlock Text="选择计划后启动真实业务流程。当前舞台只拥有执行决定和总体进度；单元细节由下方队列负责。" Foreground="{StaticResource White76Brush}" FontSize="12" TextWrapping="Wrap" LineHeight="20" Margin="2,17,0,0" MaxWidth="540" />
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Content="开始流程  →" />
                                <Button Grid.Column="2" Command="{Binding StopCommand}" Style="{StaticResource OutlineButton}" Content="停止" />
                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Width="210">
                                    <DockPanel><TextBlock Text="OVERALL" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" Foreground="{StaticResource PaperBrush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel>
                                    <controls:SmoothProgressBar Style="{StaticResource MaximalProgress}" TargetValue="{Binding OverallProgress}" Maximum="100" Margin="0,7,0,0" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PaperPanel}">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="92" /></Grid.RowDefinitions>
                        <Border Background="{StaticResource SignalBrush}" Padding="18,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="EXECUTION PLAN" Foreground="{StaticResource InkBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="READY" Foreground="{StaticResource InkBrush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel></Border>
                        <StackPanel Grid.Row="1" Margin="19,18">
                            <TextBlock Text="SELECT PLAN / 选择方案" Foreground="#77000000" Style="{StaticResource MicroLabel}" />
                            <ComboBox ItemsSource="{Binding Plans}" SelectedItem="{Binding SelectedPlan}" Margin="0,8,0,18" Padding="10" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                            <Rectangle Height="1" Fill="{StaticResource Black10Brush}" />
                            <TextBlock Text="ACTION CONSEQUENCE" Foreground="#77000000" Style="{StaticResource MicroLabel}" Margin="0,17,0,0" />
                            <TextBlock Text="演示实现只改变内存状态。替换 IOperationsBackend 后，此按钮可启动你的真实任务。" Foreground="#B0000000" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />
                        </StackPanel>
                        <Border Grid.Row="2" Background="{StaticResource InkBrush}" Padding="18,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LAST OUTCOME" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding OperationMessage}" Foreground="{StaticResource PaperBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,12,0" /></StackPanel><Rectangle Grid.Column="1" Fill="{StaticResource SignalBrush}" /></Grid></Border>
                    </Grid>
                </Border>
            </Grid>

            <ItemsControl Grid.Row="4" ItemsSource="{Binding Metrics}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource DarkPanel}" Margin="0,0,10,0" Padding="17,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Label}" Foreground="{StaticResource White76Brush}" FontSize="11" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><TextBlock Text="{Binding Value}" Foreground="{StaticResource PaperBrush}" FontFamily="{StaticResource DisplayFont}" FontWeight="Black" FontSize="31" /><TextBlock Text="{Binding Unit}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" VerticalAlignment="Bottom" Margin="7,0,0,6" /></StackPanel><TextBlock Text="{Binding Note}" Foreground="{StaticResource White52Brush}" FontSize="9" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Index}" Foreground="{StaticResource White14Brush}" FontFamily="{StaticResource DisplayFont}" FontSize="32" FontWeight="Black" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.75*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource DarkPanel}" Padding="18,15">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10"><StackPanel><TextBlock Text="WORK UNITS" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="活动单元" Foreground="{StaticResource PaperBrush}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel><TextBlock Text="STATE-DRIVEN / LIVE" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></DockPanel>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding WorkUnits}"><ItemsControl.ItemTemplate><DataTemplate><Grid Height="51"><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="140" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><Border Grid.ColumnSpan="5" BorderBrush="{StaticResource White14Brush}" BorderThickness="0,0,0,1" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource PaperBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Stage}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" /><StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,18,0"><DockPanel><TextBlock Text="{Binding Status}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel><controls:SmoothProgressBar Style="{StaticResource MaximalProgress}" TargetValue="{Binding Progress}" Maximum="100" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="4" Text="{Binding Owner}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource DarkPanel}" Padding="14"><controls:RegionHost RegionKey="command.secondary" Title="次级仪表" Description="可挂载健康度、领域统计或你的实时图表。" /></Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
