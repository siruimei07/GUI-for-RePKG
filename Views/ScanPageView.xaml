<UserControl x:Class="WallpaperField.Views.ScanPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperField"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid>
        <!-- Page 01: scan workspace. The root stays transparent so the shell stage grid shows through. -->
        <Grid x:Name="ScanView" RenderTransformOrigin="0.5,0.5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="20,16,20,16" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                            <Setter Property="Margin" Value="12,10,12,10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Regular}">
                            <Setter Property="Margin" Value="16,12,16,12" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <!-- The shell reveals each direct child of this layout in reading order; keep it to five sections. -->
            <Grid x:Name="ScanPageLayout" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <Grid x:Name="ScanPageHeader" Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Page coordinate: index chip, kicker and a rule running to the stats block. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IndexChip}" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock VerticalAlignment="Center" Text="01" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TechnicalLabel}"
                                           Text="SOURCE INTAKE / 扫描中心" />
                                <Border Grid.Column="2"
                                        Height="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BorderBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock x:Name="ScanPageTitle"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="扫描壁纸项目" />
                            <Border Width="40"
                                    Height="3"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentActionBrush}"
                                    IsHitTestVisible="False" />
                            <TextBlock x:Name="ScanDescription"
                                       Margin="0,8,0,0"
                                       MaxWidth="630"
                                       HorizontalAlignment="Left"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="读取 Workshop 子目录中的 project.json 与 preview；扫描结果保留在内存中，不向输出目录写入文件。"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Scan readouts: caption over a tabular numeral, separated by hairline rules. -->
                        <Grid x:Name="ScanStats" Grid.Column="1" Margin="28,0,10,0" VerticalAlignment="Bottom">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel MinWidth="80">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="SCANNED / 已扫描" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource StatReadout}" Text="{Binding ScanSession.ScannedCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Height="46" Margin="18,0" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                            <StackPanel Grid.Column="2" MinWidth="80">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="NO PREVIEW / 无预览" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource StatReadout}" Text="{Binding ScanSession.MissingPreviewCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Height="46" Margin="18,0" VerticalAlignment="Bottom" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                            <StackPanel Grid.Column="4" MinWidth="80">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="8"
                                               Height="8"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Fill="{DynamicResource SuccessBrush}"
                                               Stroke="{DynamicResource TextPrimaryBrush}"
                                               StrokeThickness="1"
                                               IsHitTestVisible="False" />
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Text="READY / 可处理" />
                                </StackPanel>
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource StatReadout}" Text="{Binding ScanSession.PackageReadyCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Primary command instrument: paper slab, ink spine and a cut corner. -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Border x:Name="ScanActionPanel"
                                Style="{StaticResource InstrumentPanel}"
                                Padding="18,14,16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TechnicalLabel}" Text="SOURCE ROOT" />
                                        <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="壁纸目录" />
                                    </StackPanel>
                                    <TextBox x:Name="SourcePathTextBox"
                                             Grid.Column="1"
                                             Margin="0,0,12,0"
                                             Style="{StaticResource PathTextBox}"
                                             AutomationProperties.Name="Wallpaper Engine 壁纸目录"
                                             Text="{Binding ScanSession.SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="例如 E:\SteamLibrary\steamapps\workshop\content\431960" />
                                    <Button x:Name="BrowseSourceButton"
                                            Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding BrowseSourceCommand}"
                                            AutomationProperties.Name="选择 Wallpaper Engine 壁纸目录"
                                            Content="选择目录" />
                                </Grid>

                                <Border Grid.Row="1"
                                        Height="1"
                                        Margin="0,9,0,0"
                                        Background="{DynamicResource BorderBrush}"
                                        IsHitTestVisible="False" />

                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TechnicalLabel}" Text="OUTPUT ROOT" />
                                        <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="输出目录" />
                                    </StackPanel>
                                    <TextBox x:Name="OutputPathTextBox"
                                             Grid.Column="1"
                                             Margin="0,0,12,0"
                                             Style="{StaticResource PathTextBox}"
                                             AutomationProperties.Name="扫描输出目录"
                                             Text="{Binding ScanSession.OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="扫描不会写入此目录；仅在解包选中项目时创建对应输出" />
                                    <Button x:Name="BrowseOutputButton"
                                            Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding BrowseOutputCommand}"
                                            AutomationProperties.Name="选择扫描输出目录"
                                            Content="选择目录" />
                                </Grid>

                                <!-- Command row caption in the label gutter; the gutter folds away in Compact. -->
                                <Grid Grid.Row="3"
                                      Width="112"
                                      Height="40"
                                      Margin="0,18,0,0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      IsHitTestVisible="False">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource TechnicalLabel}" Text="EXECUTE" />
                                        <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="执行操作" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="3">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Margin" Value="120,18,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Margin" Value="0,16,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ScanButton"
                                            MinWidth="168"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding ScanSession.ScanCommand}"
                                            AutomationProperties.Name="扫描壁纸项目">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" Text="&#xE721;" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding ScanSession.ScanButtonText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CancelScanButton"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            MinWidth="168"
                                            Margin="0,8,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding ScanSession.CancelScanCommand}"
                                            Visibility="{Binding ScanSession.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="取消扫描"
                                            Content="取消扫描" />
                                    <Button x:Name="UnpackButton"
                                            Grid.Column="1"
                                            MinWidth="152"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding UnpackCommand}"
                                            AutomationProperties.Name="解包勾选的 PKG 或视频项目"
                                            ToolTip="{Binding ScanSession.UnpackToolTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" Text="&#xE7B8;" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding UnpackButtonText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="CancelUnpackButton"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            MinWidth="152"
                                            Margin="12,8,0,0"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding UnpackSession.CancelUnpackCommand}"
                                            Visibility="{Binding UnpackSession.IsUnpacking, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="取消解包"
                                            Content="取消解包" />
                                    <Button x:Name="BrowseScannedProjectsButton"
                                            Grid.Column="2"
                                            MinWidth="150"
                                            Margin="12,0,0,0"
                                            Style="{StaticResource SecondaryButton}"
                                            Command="{Binding NavigateBrowseCommand}"
                                            Visibility="{Binding BrowsePageViewModel.HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="浏览扫描项目">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Margin="0,0,9,0" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" Text="&#xE8B7;" />
                                            <TextBlock VerticalAlignment="Center" Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}浏览 {0} 个项目}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="UnpackProgressPanel" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Grid.Row" Value="0" />
                                                <Setter Property="Grid.RowSpan" Value="2" />
                                                <Setter Property="Grid.Column" Value="3" />
                                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                                <Setter Property="Margin" Value="24,0,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                                        <Setter Property="Grid.Row" Value="2" />
                                                        <Setter Property="Grid.RowSpan" Value="1" />
                                                        <Setter Property="Grid.Column" Value="0" />
                                                        <Setter Property="Grid.ColumnSpan" Value="4" />
                                                        <Setter Property="Margin" Value="0,14,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <ProgressBar x:Name="UnpackProgressBar"
                                                     Height="6"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                     Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="UnpackStatusText"
                                                       Grid.Column="0"
                                                       Style="{StaticResource TechnicalLabel}"
                                                       Text="{Binding StatusText}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="UnpackStageText"
                                                       Grid.Column="1"
                                                       Margin="16,0,0,0"
                                                       Style="{StaticResource TechnicalLabel}"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       Text="{Binding CurrentStage}" />
                                            <TextBlock x:Name="UnpackWorkText"
                                                       Grid.Column="2"
                                                       Margin="16,0,0,0"
                                                       HorizontalAlignment="Right"
                                                       Style="{StaticResource TechnicalLabel}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding UnpackWorkText}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Width="4"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource TextPrimaryBrush}"
                                IsHitTestVisible="False" />
                        <Path Width="10"
                              Height="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 10,0 10,10 Z"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              IsHitTestVisible="False" />
                    </Grid>

                    <!-- Problem banner: amber rail and "!" while scan/unpack issues are open, cyan check when clear. -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Border x:Name="ScanProblemSummary"
                                Padding="16,9,12,9"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="4,1,1,1"
                                AutomationProperties.LiveSetting="Polite">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24"
                                        Height="24"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProblemCenterSession.ScanIssueCount}" Value="0">
                                                    <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource LabelFontFamily}"
                                                   FontSize="14"
                                                   FontWeight="Black"
                                                   Foreground="{DynamicResource SignalTextBrush}"
                                                   Text="!">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProblemCenterSession.ScanIssueCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="{DynamicResource IconFontFamily}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SignalTextBrush}"
                                                   Text="&#xE73E;">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProblemCenterSession.ScanIssueCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Text="PROBLEM SUMMARY / 扫描与解包" />
                                    <TextBlock Margin="0,3,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding ProblemCenterSession.ScanSummary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="124"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding NavigateProblemsCommand}"
                                        Content="查看全部问题"
                                        AutomationProperties.Name="查看全部扫描与解包问题" />
                            </Grid>
                        </Border>
                        <Border Width="4" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ProblemCenterSession.ScanIssueCount}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="2,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="扫描结果" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="NAME FILTER / 实时筛选">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource TechnicalLabel}"
                                           TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Regular}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <!-- Single-row toolbar: no padding, border or vertical margin (height contract <= 40.5 DIP). -->
                        <Border x:Name="ScanEfficiencyToolbar"
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center">
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton x:Name="OnlyProcessableFilter"
                                              MinWidth="68"
                                              Margin="0,0,4,0"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding ScanSession.ShowOnlyProcessable, Mode=TwoWay}"
                                              Content="可处理"
                                              ToolTip="仅显示可处理项目"
                                              AutomationProperties.Name="仅显示可处理的扫描结果" />
                                <ToggleButton x:Name="OnlyProblemsFilter"
                                              MinWidth="68"
                                              Margin="0,0,8,0"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding ScanSession.ShowOnlyProblems, Mode=TwoWay}"
                                              Content="有问题"
                                              ToolTip="仅显示有开放问题的项目"
                                              AutomationProperties.Name="仅显示有开放问题的扫描结果" />
                                <Button x:Name="SelectCurrentMatchesButton"
                                        MinWidth="88"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource EfficiencyButton}"
                                        Command="{Binding ScanSession.SelectCurrentMatchesCommand}"
                                        Content="选择匹配"
                                        ToolTip="选择当前匹配中的全部可处理项目"
                                        AutomationProperties.Name="选择当前匹配中的可处理项目" />
                                <Button x:Name="ClearUnpackSelectionButton"
                                        MinWidth="60"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource EfficiencyButton}"
                                        Command="{Binding ScanSession.ClearUnpackSelectionCommand}"
                                        Content="清空"
                                        ToolTip="清除全部解包选择，包括当前筛选隐藏的项目"
                                        AutomationProperties.Name="清除全部解包选择" />
                                <ToggleButton x:Name="CompactDensityToggle"
                                              MinWidth="68"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding IsCompactDensity, Mode=TwoWay}"
                                              Content="紧凑"
                                              ToolTip="切换紧凑卡片密度"
                                              AutomationProperties.Name="使用紧凑卡片密度" />
                            </WrapPanel>
                        </Border>
                        <!-- Search geometry is coupled to SearchTextBox Padding 46,0,154,0. -->
                        <Grid x:Name="ScanSearchPanel"
                              Grid.Column="2"
                              Height="40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="280" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Width" Value="250" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Wide}">
                                            <Setter Property="Width" Value="330" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBox x:Name="ScanSearchBox"
                                     Style="{StaticResource SearchTextBox}"
                                     AutomationProperties.Name="搜索扫描结果中的壁纸名称"
                                     AutomationProperties.HelpText="输入名称后仅显示标题中包含该关键词的壁纸"
                                     Text="{Binding ScanSession.ScanSearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="&#xE721;" />
                            <TextBlock Margin="47,0,130,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="搜索名称">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ScanSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="32"
                                    Padding="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,7,0" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Margin" Value="0,0,51,0" />
                                                <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentActionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                 <TextBlock x:Name="SelectionSummaryText"
                                            VerticalAlignment="Center"
                                            FontFamily="{DynamicResource LabelFontFamily}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Text="{Binding ScanSession.SelectionSummaryText}"
                                            AutomationProperties.LiveSetting="Polite">
                                     <TextBlock.Style>
                                         <Style TargetType="TextBlock">
                                             <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                     <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </TextBlock.Style>
                                     <AutomationProperties.Name>
                                         <Binding Path="ScanSession.SelectionSummaryText" />
                                     </AutomationProperties.Name>
                                 </TextBlock>
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,3,0"
                                    BorderBrush="Transparent"
                                    FontFamily="{DynamicResource IconFontFamily}"
                                    FontSize="14"
                                    Command="{Binding ScanSession.ClearScanSearchCommand}"
                                    AutomationProperties.Name="清除扫描结果搜索"
                                    ToolTip="清除搜索"
                                    Content="&#xE711;">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Margin="2,0"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Height" Value="3" />
                                                <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" MinHeight="48">
                        <ListBox x:Name="ScanResultsList"
                                 ItemsSource="{Binding ScanSession.FilteredScannedWallpapers}"
                                 ItemTemplate="{DynamicResource WallpaperCardTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <!-- Square selection box centred on the card's 66 px right column
                                                         (card margin 0,0,4,8 -> right 4 + (66 - 38) / 2 = 18). -->
                                                    <CheckBox Width="38"
                                                              Height="38"
                                                              Margin="0,0,18,8"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Panel.ZIndex="5"
                                                              IsChecked="{Binding IsSelectedForUnpack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              AutomationProperties.Name="{Binding Title, StringFormat=选择解包：{0}}"
                                                              ToolTip="勾选后才会解包或复制此项目">
                                                        <CheckBox.Style>
                                                            <Style TargetType="CheckBox">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                                <Setter Property="Cursor" Value="Hand" />
                                                                <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual}" />
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding CanSelectForUnpack}" Value="True" />
                                                                            <Condition Binding="{Binding DataContext.ScanSession.IsSelectionWritable, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </CheckBox.Style>
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Border x:Name="SelectionBox"
                                                                        Width="38"
                                                                        Height="38"
                                                                        Background="{DynamicResource SurfaceBrush}"
                                                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                                                        BorderThickness="2"
                                                                        CornerRadius="0">
                                                                    <TextBlock x:Name="SelectionGlyph"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="{DynamicResource IconFontFamily}"
                                                                               FontSize="16"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource SignalTextBrush}"
                                                                               Text="&#xE73E;"
                                                                               Visibility="Collapsed" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        <Setter TargetName="SelectionGlyph" Property="Visibility" Value="Visible" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                                        <Setter TargetName="SelectionBox" Property="Opacity" Value="0.4" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Empty state: outlined 56 px icon frame with a cut corner, title and muted guidance. -->
                        <Border Padding="16"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanSession.HasVisibleScanResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid Width="56" Height="56" HorizontalAlignment="Center" IsHitTestVisible="False">
                                    <Border Background="{DynamicResource SurfaceMutedBrush}"
                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                            BorderThickness="1" />
                                    <Path Width="10"
                                          Height="10"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top"
                                          Data="M 0,0 L 10,0 10,10 Z"
                                          Fill="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource IconFontFamily}"
                                               FontSize="24"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="&#xEC31;" />
                                </Grid>
                                <TextBlock Margin="0,12,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Text="{Binding ScanSession.ScanEmptyTitle}" />
                                <TextBlock Margin="0,4,0,0"
                                           MaxWidth="460"
                                           HorizontalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding ScanSession.ScanEmptyDescription}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
