<UserControl x:Class="WallpaperField.Views.ScanPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperField"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid>
        <!-- Scan mode owns a real source-to-index route instrument. -->
        <Canvas x:Name="ScanStageOverlay"
                IsHitTestVisible="False"
                Opacity="0.13">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Path Stroke="{DynamicResource InkBrush}"
                  StrokeThickness="1"
                  StrokeDashArray="7,8"
                  Data="M 54,566 L 260,566 L 330,518 L 590,518 L 660,566 L 954,566" />
            <Ellipse Canvas.Left="49" Canvas.Top="561" Width="10" Height="10" Fill="{DynamicResource SignalPressedBrush}" />
            <Ellipse Canvas.Left="325" Canvas.Top="513" Width="10" Height="10" Fill="{DynamicResource InkBrush}" />
            <Ellipse Canvas.Left="585" Canvas.Top="513" Width="10" Height="10" Fill="{DynamicResource InkBrush}" />
            <Ellipse Canvas.Left="949" Canvas.Top="561" Width="10" Height="10" Fill="{DynamicResource SignalPressedBrush}" />
            <TextBlock Canvas.Left="54" Canvas.Top="578" Style="{StaticResource TechnicalLabel}" Text="SOURCE ROOT" />
            <TextBlock Canvas.Left="330" Canvas.Top="530" Style="{StaticResource TechnicalLabel}" Text="PROJECT.JSON" />
            <TextBlock Canvas.Left="590" Canvas.Top="530" Style="{StaticResource TechnicalLabel}" Text="PREVIEW MEDIA" />
            <TextBlock Canvas.Left="868" Canvas.Top="578" Style="{StaticResource TechnicalLabel}" Text="LOCAL INDEX" />
        </Canvas>
        <!-- Page 01: scan workspace -->
        <Grid x:Name="ScanView" RenderTransformOrigin="0.5,0.5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="34,24,28,20" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsScanPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                            <Setter Property="Margin" Value="22,16,18,14" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Regular}">
                            <Setter Property="Margin" Value="28,20,22,16" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid x:Name="ScanPageLayout" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <Grid x:Name="ScanPageHeader" Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="FIELD INDEX / 01 · SOURCE INTAKE" />
                            <TextBlock x:Name="ScanPageTitle"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="扫描壁纸项目" />
                            <TextBlock x:Name="ScanDescription"
                                       Margin="2,9,0,0"
                                       MaxWidth="630"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="读取 Workshop 子目录中的 project.json 与 preview；扫描结果保留在内存中，不向输出目录写入文件。"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <Grid x:Name="ScanStats" Grid.Column="1" Margin="28,0,10,0" VerticalAlignment="Bottom">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Width="90">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="SCANNED" />
                                <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding ScanSession.ScannedCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Height="42" Margin="18,0" Background="{DynamicResource BorderBrush}" />
                            <StackPanel Grid.Column="2" Width="90">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="NO PREVIEW" />
                                <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding ScanSession.MissingPreviewCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Height="42" Margin="18,0" Background="{DynamicResource BorderBrush}" />
                            <StackPanel Grid.Column="4" Width="90">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="READY" />
                                <TextBlock Margin="0,4,0,0" FontFamily="Arial Narrow" FontSize="29" FontWeight="Bold" Text="{Binding ScanSession.PackageReadyCount, StringFormat={}{0:00}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border x:Name="ScanActionPanel"
                            Grid.Row="1"
                            Style="{StaticResource DarkPanel}"
                            Padding="24,18"
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="SOURCE ROOT" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="壁纸目录" />
                                </StackPanel>
                                <TextBox x:Name="SourcePathTextBox"
                                         Grid.Column="1"
                                         Margin="0,0,12,0"
                                         Style="{StaticResource PathTextBox}"
                                         AutomationProperties.Name="Wallpaper Engine 壁纸目录"
                                         Text="{Binding ScanSession.SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="例如 E:\SteamLibrary\steamapps\workshop\content\431960" />
                                <Button x:Name="BrowseSourceButton"
                                        Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Foreground="{DynamicResource PaperBrush}"
                                        BorderBrush="{DynamicResource Paper24Brush}"
                                        Command="{Binding BrowseSourceCommand}"
                                        AutomationProperties.Name="选择 Wallpaper Engine 壁纸目录"
                                        Content="选择目录" />
                            </Grid>

                            <Border Grid.Row="1" Margin="0,17" Background="{DynamicResource Paper24Brush}" />

                            <Grid Grid.Row="2" Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="OUTPUT ROOT" />
                                    <TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PaperBrush}" Text="输出目录" />
                                </StackPanel>
                                <TextBox x:Name="OutputPathTextBox"
                                         Grid.Column="1"
                                         Margin="0,0,12,0"
                                         Style="{StaticResource PathTextBox}"
                                         AutomationProperties.Name="扫描输出目录"
                                         Text="{Binding ScanSession.OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="扫描不会写入此目录；仅在解包选中项目时创建对应输出" />
                                <Button x:Name="BrowseOutputButton"
                                        Grid.Column="2"
                                        Style="{StaticResource GhostButton}"
                                        Foreground="{DynamicResource PaperBrush}"
                                        BorderBrush="{DynamicResource Paper24Brush}"
                                        Command="{Binding BrowseOutputCommand}"
                                        AutomationProperties.Name="选择扫描输出目录"
                                        Content="选择目录" />
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="120,18,0,0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Margin" Value="0,16,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="ScanButton"
                                        MinWidth="168"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ScanSession.ScanCommand}"
                                        AutomationProperties.Name="扫描壁纸项目">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,9,0" FontFamily="Segoe Fluent Icons" Text="&#xE721;" />
                                        <TextBlock Text="{Binding ScanSession.ScanButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelScanButton"
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        MinWidth="168"
                                        Margin="0,8,0,0"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding ScanSession.CancelScanCommand}"
                                        Visibility="{Binding ScanSession.IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="取消扫描"
                                        Content="取消扫描" />
                                <Button x:Name="UnpackButton"
                                        Grid.Column="1"
                                        MinWidth="152"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding UnpackCommand}"
                                        AutomationProperties.Name="解包勾选的 PKG 或视频项目"
                                        ToolTip="{Binding ScanSession.UnpackToolTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,9,0" FontFamily="Segoe Fluent Icons" Text="&#xE7B8;" />
                                        <TextBlock Text="{Binding UnpackButtonText}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelUnpackButton"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        MinWidth="152"
                                        Margin="12,8,0,0"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding UnpackSession.CancelUnpackCommand}"
                                        Visibility="{Binding UnpackSession.IsUnpacking, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="取消解包"
                                        Content="取消解包" />
                                <Button x:Name="BrowseScannedProjectsButton"
                                        Grid.Column="2"
                                        MinWidth="150"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding NavigateBrowseCommand}"
                                        Visibility="{Binding BrowsePageViewModel.HasSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.Name="浏览扫描项目">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,9,0" FontFamily="Segoe Fluent Icons" Text="&#xE8B7;" />
                                        <TextBlock Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}浏览 {0} 个项目}" />
                                    </StackPanel>
                                </Button>
                                <StackPanel x:Name="UnpackProgressPanel" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Grid.Row" Value="0" />
                                            <Setter Property="Grid.RowSpan" Value="2" />
                                            <Setter Property="Grid.Column" Value="3" />
                                            <Setter Property="Grid.ColumnSpan" Value="1" />
                                            <Setter Property="Margin" Value="24,0,0,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                                    <Setter Property="Grid.Row" Value="2" />
                                                    <Setter Property="Grid.RowSpan" Value="1" />
                                                    <Setter Property="Grid.Column" Value="0" />
                                                    <Setter Property="Grid.ColumnSpan" Value="4" />
                                                    <Setter Property="Margin" Value="0,14,0,0" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Grid>
                                        <ProgressBar x:Name="UnpackProgressBar"
                                                     Height="5"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                     Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Paper24Brush}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UnpackStatusText"
                                                   Grid.Column="0"
                                                   Style="{StaticResource TechnicalLabel}"
                                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                   Text="{Binding StatusText}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="UnpackStageText"
                                                   Grid.Column="1"
                                                   Margin="16,0,0,0"
                                                   Style="{StaticResource TechnicalLabel}"
                                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                   Text="{Binding CurrentStage}" />
                                        <TextBlock x:Name="UnpackWorkText"
                                                   Grid.Column="2"
                                                   Margin="16,0,0,0"
                                                   HorizontalAlignment="Right"
                                                   Style="{StaticResource TechnicalLabel}"
                                                   Foreground="{DynamicResource PaperBrush}"
                                                   Text="{Binding UnpackWorkText}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="ScanProblemSummary"
                            Grid.Row="2"
                            Margin="0,0,0,12"
                            Padding="14,11"
                            Background="{DynamicResource PaperElevatedBrush}"
                            BorderBrush="{DynamicResource SignalPressedBrush}"
                            BorderThickness="5,1,1,1"
                            CornerRadius="12"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="{DynamicResource SignalBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="{DynamicResource SignalTextBrush}" Text="!" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="PROBLEM SUMMARY / 扫描与解包" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding ProblemCenterSession.ScanSummary}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    MinWidth="124"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NavigateProblemsCommand}"
                                    Content="查看全部问题"
                                    AutomationProperties.Name="查看全部扫描与解包问题" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="2,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="扫描结果" />
                            <TextBlock Margin="0,3,0,0"
                                       Text="NAME FILTER / 实时筛选">
                                <TextBlock.Style>
                                    <Style BasedOn="{StaticResource TechnicalLabel}"
                                           TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Regular}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Border x:Name="ScanEfficiencyToolbar"
                                Grid.Column="1"
                                Margin="12,0"
                                VerticalAlignment="Center">
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ToggleButton x:Name="OnlyProcessableFilter"
                                              MinWidth="68"
                                              Margin="0,0,4,0"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding ScanSession.ShowOnlyProcessable, Mode=TwoWay}"
                                              Content="可处理"
                                              ToolTip="仅显示可处理项目"
                                              AutomationProperties.Name="仅显示可处理的扫描结果" />
                                <ToggleButton x:Name="OnlyProblemsFilter"
                                              MinWidth="68"
                                              Margin="0,0,8,0"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding ScanSession.ShowOnlyProblems, Mode=TwoWay}"
                                              Content="有问题"
                                              ToolTip="仅显示有开放问题的项目"
                                              AutomationProperties.Name="仅显示有开放问题的扫描结果" />
                                <Button x:Name="SelectCurrentMatchesButton"
                                        MinWidth="88"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource EfficiencyButton}"
                                        Command="{Binding ScanSession.SelectCurrentMatchesCommand}"
                                        Content="选择匹配"
                                        ToolTip="选择当前匹配中的全部可处理项目"
                                        AutomationProperties.Name="选择当前匹配中的可处理项目" />
                                <Button x:Name="ClearUnpackSelectionButton"
                                        MinWidth="60"
                                        Margin="0,0,4,0"
                                        Style="{StaticResource EfficiencyButton}"
                                        Command="{Binding ScanSession.ClearUnpackSelectionCommand}"
                                        Content="清空"
                                        ToolTip="清除全部解包选择，包括当前筛选隐藏的项目"
                                        AutomationProperties.Name="清除全部解包选择" />
                                <ToggleButton x:Name="CompactDensityToggle"
                                              MinWidth="68"
                                              Style="{StaticResource FilterToggleButton}"
                                              IsChecked="{Binding IsCompactDensity, Mode=TwoWay}"
                                              Content="紧凑"
                                              ToolTip="切换紧凑卡片密度"
                                              AutomationProperties.Name="使用紧凑卡片密度" />
                            </WrapPanel>
                        </Border>
                        <Grid x:Name="ScanSearchPanel"
                              Grid.Column="2"
                              Height="50">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="280" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Width" Value="250" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Wide}">
                                            <Setter Property="Width" Value="330" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBox x:Name="ScanSearchBox"
                                     Style="{StaticResource SearchTextBox}"
                                     AutomationProperties.Name="搜索扫描结果中的壁纸名称"
                                     AutomationProperties.HelpText="输入名称后仅显示标题中包含该关键词的壁纸"
                                     Text="{Binding ScanSession.ScanSearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="15"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="&#xE721;" />
                            <TextBlock Margin="47,0,130,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="搜索名称">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ScanSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="32"
                                    Padding="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,7,0" />
                                        <Setter Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Margin" Value="0,0,51,0" />
                                                <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                 <TextBlock x:Name="SelectionSummaryText"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource InkBrush}"
                                            Text="{Binding ScanSession.SelectionSummaryText}"
                                            AutomationProperties.LiveSetting="Polite">
                                     <AutomationProperties.Name>
                                         <Binding Path="ScanSession.SelectionSummaryText" />
                                     </AutomationProperties.Name>
                                 </TextBlock>
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,3,0"
                                    Command="{Binding ScanSession.ClearScanSearchCommand}"
                                    AutomationProperties.Name="清除扫描结果搜索"
                                    ToolTip="清除搜索"
                                    Content="&#xE711;">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Margin="2,0"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScanSession.HasScanSearchText}" Value="True">
                                                <Setter Property="Height" Value="3" />
                                                <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" MinHeight="48">
                        <ListBox x:Name="ScanResultsList"
                                 ItemsSource="{Binding ScanSession.FilteredScannedWallpapers}"
                                 ItemTemplate="{DynamicResource WallpaperCardTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid>
                                                    <ContentPresenter />
                                                    <CheckBox Width="38"
                                                              Height="38"
                                                              Margin="0,0,22,12"
                                                              HorizontalAlignment="Right"
                                                              VerticalAlignment="Center"
                                                              Panel.ZIndex="5"
                                                              IsChecked="{Binding IsSelectedForUnpack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEnabled="{Binding CanSelectForUnpack}"
                                                              AutomationProperties.Name="{Binding Title, StringFormat=选择解包：{0}}"
                                                              ToolTip="勾选后才会解包或复制此项目">
                                                        <CheckBox.Template>
                                                            <ControlTemplate TargetType="CheckBox">
                                                                <Border x:Name="SelectionBox"
                                                                        Width="38"
                                                                        Height="38"
                                                                        Background="{DynamicResource PaperBrush}"
                                                                        BorderBrush="{DynamicResource Ink42Brush}"
                                                                        BorderThickness="2"
                                                                        CornerRadius="10">
                                                                    <TextBlock x:Name="SelectionGlyph"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontFamily="Segoe UI Symbol"
                                                                               FontSize="17"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource SignalTextBrush}"
                                                                               Text="✓"
                                                                               Visibility="Collapsed" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsChecked" Value="True">
                                                                        <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource SignalBrush}" />
                                                                        <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource SignalBrush}" />
                                                                        <Setter TargetName="SelectionGlyph" Property="Visibility" Value="Visible" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="SelectionBox" Property="Opacity" Value="0.35" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </CheckBox.Template>
                                                    </CheckBox>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Border Padding="28"
                                Background="{DynamicResource PaperBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanSession.HasVisibleScanResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="29" Foreground="{DynamicResource TextMutedBrush}" Text="&#xEC31;" />
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="{Binding ScanSession.ScanEmptyTitle}" />
                                <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ScanSession.ScanEmptyDescription}" />
                            </StackPanel>
                        </Border>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
