<UserControl x:Class="WallpaperField.Views.BrowsePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="项目浏览">
    <Grid x:Name="BrowseView" Margin="28,24,28,28">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBrowsePage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="BrowsePageHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TechnicalLabel}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="PROJECT BROWSER / 02" />
                <TextBlock x:Name="BrowsePageTitle"
                           Margin="0,6,0,0"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="项目浏览"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Margin="0,7,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="浏览当前成功扫描的项目快照" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="12,8"
                    VerticalAlignment="Top"
                    Background="{DynamicResource PaperMutedBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <TextBlock FontFamily="Consolas"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}SNAPSHOT / {0} ITEMS}" />
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,13"
                Background="{DynamicResource PaperMutedBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource TechnicalLabel}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="CURRENT SOURCE" />
                <TextBlock Grid.Column="1"
                           Margin="18,0"
                           FontFamily="Consolas"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding ScanSession.SourcePath}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding ScanSession.SourcePath}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ScanSession.SourcePath}" Value="">
                                    <Setter Property="Text" Value="尚未选择来源目录" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Setter Property="Text" Value="尚无成功快照" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BrowsePageViewModel.HasSnapshot}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessInkBrush}" />
                                    <Setter Property="Text" Value="成功快照已载入" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="36"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BrowsePageViewModel.HasVisibleProjects}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock HorizontalAlignment="Center"
                           FontFamily="Segoe Fluent Icons"
                           FontSize="32"
                           Foreground="{DynamicResource SignalPressedBrush}"
                           Text="&#xE8B7;" />
                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding BrowsePageViewModel.EmptyTitle}" />
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding BrowsePageViewModel.EmptyDescription}" />
                <Button x:Name="BrowseScanCenterButton"
                        Margin="0,22,0,0"
                        MinWidth="160"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NavigateScanCommand}"
                        AutomationProperties.Name="前往扫描中心"
                        Content="前往扫描中心" />
            </StackPanel>
        </Border>

        <Border x:Name="BrowseReadyState"
                Grid.Row="3"
                Margin="0,18,0,0"
                Padding="36"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BrowsePageViewModel.HasVisibleProjects}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}已载入 {0} 个项目}" />
                <TextBlock Margin="0,9,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="项目快照已准备好；浏览内容将在项目视图中呈现。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
