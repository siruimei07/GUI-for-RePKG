<UserControl x:Class="WallpaperField.Views.BrowsePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WallpaperField.Controls"
             xmlns:local="clr-namespace:WallpaperField"
             xmlns:viewModels="clr-namespace:WallpaperField.ViewModels"
             AutomationProperties.Name="项目浏览"
             DataContextChanged="BrowsePageView_DataContextChanged"
             Loaded="BrowsePageView_Loaded"
             Unloaded="BrowsePageView_Unloaded"
             PreviewGotKeyboardFocus="BrowsePageView_PreviewGotKeyboardFocus"
             SizeChanged="BrowsePageView_SizeChanged">
    <UserControl.Resources>
        <DataTemplate x:Key="BrowseFilterOptionTemplate">
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Label}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- Quiet action on the light details surfaces. Ink text on white / muted paper stays far above
             4.5:1 on both the persistent pane and the compact overlay, which now share one polarity. -->
        <Style x:Key="BrowseDetailsGhostButton"
               BasedOn="{StaticResource GhostButton}"
               TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        </Style>
        <!-- Quiet action on the ink processing dock: paper text with an on-dark rule. -->
        <Style x:Key="BrowseTrayGhostButton"
               BasedOn="{StaticResource GhostButton}"
               TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextOnDarkMutedBrush}" />
        </Style>
        <DataTemplate x:Key="BrowseProjectActionsTemplate">
            <StackPanel Margin="12,8,12,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BrowseProjectOpenFolderButton"
                             MinHeight="44"
                             Style="{StaticResource SecondaryButton}"
                             Command="{Binding BrowsePageViewModel.OpenCurrentFolderCommand}"
                             AutomationProperties.Name="打开目录（当前项目显示目标）"
                             Content="打开目录" />
                    <Button x:Name="BrowseProjectProblemsButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            MinHeight="44"
                             Command="{Binding ShowBrowseProjectProblemsCommand}"
                             CommandParameter="{Binding BrowsePageViewModel.CurrentProject}"
                             AutomationProperties.Name="问题中心（当前项目）"
                             Content="问题中心">
                        <Button.Style>
                            <Style BasedOn="{StaticResource BrowseDetailsGhostButton}"
                                   TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BrowsePageViewModel.CurrentProject.HasProblems}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <Button x:Name="BrowseProjectProcessButton"
                        Margin="0,8,0,0"
                        MinHeight="44"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding ProcessCurrentBrowseProjectCommand}"
                        ToolTip="{Binding CurrentBrowseProjectActionAvailabilityText}"
                        AutomationProperties.HelpText="{Binding CurrentBrowseProjectActionAvailabilityText}"
                        AutomationProperties.Name="{Binding BrowsePageViewModel.CurrentProjectActionText}"
                        Content="{Binding BrowsePageViewModel.CurrentProjectActionText}" />
                <TextBlock x:Name="BrowseProjectFolderActionStatusText"
                           Margin="0,7,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="{Binding BrowseProjectActionStatusText}"
                           AutomationProperties.AutomationId="BrowseProjectFolderActionLiveRegion"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding BrowseProjectActionStatusText}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BrowseProjectDetailsTemplate">
            <StackPanel Margin="12">
                <Border x:Name="BrowseDetailPreviewFrame"
                        Background="{DynamicResource InkSoftBrush}"
                        ClipToBounds="True"
                        CornerRadius="0"
                        SizeChanged="BrowseDetailPreviewFrame_SizeChanged">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Height" Value="180" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="{x:Static local:ShellLayoutMode.Wide}">
                                    <Setter Property="MaxHeight" Value="136" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="25"
                                       Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                       Text="&#xE91B;" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource PaperBrush}"
                                       Text="静态预览" />
                        </StackPanel>
                        <controls:ThumbnailPreviewImage ThumbnailService="{Binding Owner.ThumbnailService}"
                                                        ProjectKey="{Binding ProjectKey}"
                                                        SourcePath="{Binding PreviewPath}"
                                                        ScanFileLength="{Binding PreviewFileLength}"
                                                        ScanLastWriteTimeUtc="{Binding PreviewLastWriteTimeUtc}"
                                                        PreviewFormat="{Binding PreviewFormat}"
                                                        SnapshotGeneration="{Binding Owner.ThumbnailGeneration}"
                                                        DecodePixelWidth="480"
                                                        Stretch="UniformToFill"
                                                        RenderOptions.BitmapScalingMode="HighQuality"
                                                        AutomationProperties.Name="{Binding Title, StringFormat=当前项目静态封面：{0}}" />
                    </Grid>
                </Border>
                <TextBlock Margin="0,12,0,0"
                           FontFamily="{DynamicResource DisplayFontFamily}"
                           FontSize="20"
                           FontWeight="Bold"
                           LineHeight="24"
                           LineStackingStrategy="BlockLineHeight"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="{Binding Title}"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0"
                           FontFamily="{DynamicResource TechnicalFontFamily}"
                           FontSize="10"
                           Foreground="{DynamicResource AccentTextBrush}"
                           Text="{Binding WorkshopId, StringFormat=WORKSHOP ID / {0}}" />
                <Separator Margin="0,12,0,12" Background="{DynamicResource BorderBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource TechnicalLabel}"
                               Text="类型 / 处理状态" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding TypeLabel}" />
                </Grid>
                <TextBlock Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding ProcessabilityText}"
                           TextWrapping="Wrap" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TechnicalLabel}"
                               Text="{Binding ProcessingTargetLabel}" />
                    <TextBlock x:Name="BrowseProcessingTargetPathText"
                               Grid.Column="1"
                               Margin="8,0,0,0"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding ProcessingTargetPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ProcessingTargetPath}" />
                </Grid>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="10"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Text="{Binding Owner.CurrentFolderTargetLabel}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding Owner.CurrentFolderDisplayPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Owner.CurrentFolderDisplayPath}" />
                </Grid>
                <TextBlock Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding WarningCount, StringFormat=提示 / {0} 条}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Page 02: project browser. The root stays transparent so the shell stage shows through, and it is
         clock-free: MotionAssist is suppressed for the whole subtree and no view-level animation exists. -->
    <Grid x:Name="BrowseView"
          controls:MotionAssist.Suppressed="True"
          IsVisibleChanged="BrowsePageView_IsVisibleChanged">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="12,12,12,10" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBrowsePage}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                        <Setter Property="Margin" Value="12,10,12,10" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                 Value="{x:Static local:ShellLayoutMode.Wide}">
                        <Setter Property="Margin" Value="12,12,12,10" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="{DynamicResource BrowseProcessingTrayGridLength}" />
        </Grid.RowDefinitions>

        <Grid x:Name="BrowsePageHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <!-- Page coordinate: index chip, kicker and a hairline rule led by a short signal bar. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="14"
                            Padding="4,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IndexChip}">
                        <TextBlock VerticalAlignment="Center" FontSize="10" Text="02" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource TechnicalLabel}"
                               Text="PROJECT BROWSER / 本地项目" />
                    <Grid Grid.Column="2"
                          Margin="12,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Border Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource BorderBrush}" />
                        <Border Width="40"
                                Height="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentActionBrush}" />
                    </Grid>
                </Grid>
                <!-- The Browse header stays no taller than v1.3 so the compact grid keeps its viewport. -->
                <TextBlock x:Name="BrowsePageTitle"
                           Margin="0,1,0,0"
                           Style="{StaticResource SectionTitle}"
                           FontSize="24"
                           LineHeight="28"
                           LineStackingStrategy="BlockLineHeight"
                           Text="项目浏览"
                           AutomationProperties.HeadingLevel="Level1" />
                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource TechnicalLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="SNAPSHOT" />
                    <TextBlock x:Name="BrowseSnapshotSourcePathText"
                               Grid.Column="1"
                               Margin="9,0,0,0"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding BrowsePageViewModel.SnapshotSourcePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BrowsePageViewModel.SnapshotSourcePath}" />
                    <TextBlock x:Name="BrowseSnapshotSourceStatusText"
                               Grid.Column="2"
                               Margin="9,0,0,0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding BrowsePageViewModel.SnapshotSourceStatusText}" />
                    <TextBlock Grid.Column="3"
                               Margin="12,0,0,0"
                               Style="{StaticResource TechnicalLabel}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="CURRENT" />
                    <TextBlock x:Name="BrowseCurrentSourcePathText"
                               Grid.Column="4"
                               Margin="9,0,0,0"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding BrowsePageViewModel.CurrentSourcePath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding BrowsePageViewModel.CurrentSourcePath}" />
                </Grid>
            </StackPanel>
            <!-- Snapshot readout badge: square paper tag with an ink lead on its left edge. -->
            <Border Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="10,6"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0">
                <Grid>
                    <Rectangle Width="3"
                               Margin="-10,-6,0,-6"
                               HorizontalAlignment="Left"
                               Fill="{DynamicResource TextPrimaryBrush}"
                               IsHitTestVisible="False" />
                    <StackPanel>
                        <TextBlock FontFamily="{DynamicResource TechnicalFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="{Binding BrowsePageViewModel.TotalProjectCount, StringFormat={}SNAPSHOT / {0} ITEMS}" />
                        <TextBlock x:Name="BrowseSnapshotCompletedAtText"
                                   Margin="0,3,0,0"
                                   FontFamily="{DynamicResource TechnicalFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding BrowsePageViewModel.SnapshotCompletedAtText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="BrowseToolbar"
                Grid.Row="2"
                Padding="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="0">
            <Grid x:Name="BrowseToolbarLayoutGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="210" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Ink spine drawn inside the toolbar padding: marks the page's control instrument
                     without changing any control geometry. Decorative, never hit-testable. -->
                <Rectangle Grid.RowSpan="2"
                           Grid.ColumnSpan="3"
                           Width="3"
                           Margin="-6,-6,0,-6"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource TextPrimaryBrush}"
                           IsHitTestVisible="False" />
                <Grid x:Name="BrowseSearchHost">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="0" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="{x:Static local:ShellLayoutMode.Regular}">
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <TextBox x:Name="BrowseSearchTextBox"
                             MinHeight="44"
                             Style="{StaticResource SearchTextBox}"
                             Text="{Binding BrowsePageViewModel.SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="搜索项目名称或 Workshop ID"
                             AutomationProperties.HelpText="输入项目名称或 Workshop ID 后筛选当前扫描快照" />
                    <!-- Active-query underline: a 3px signal bar while the search narrows the snapshot. -->
                    <Border Height="3"
                            Margin="1,0,1,1"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentActionBrush}"
                            IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BrowseSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock x:Name="BrowseSearchIcon"
                               Margin="16,0,0,0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="{DynamicResource IconFontFamily}"
                               FontSize="15"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="&#xE721;" />
                    <TextBlock x:Name="BrowseSearchWatermark"
                               Margin="47,0,154,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="搜索名称或 Workshop ID">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BrowseSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                     <TextBlock x:Name="BrowseSearchMatchCountText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding BrowsePageViewModel.MatchSummaryText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="0,0,56,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BrowseSearchTextBox}" Value="">
                                        <Setter Property="Margin" Value="0,0,12,0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="BrowseSearchClearButton"
                            Margin="0,0,3,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BrowseSearchClearButton_Click"
                            AutomationProperties.Name="清除项目搜索"
                            ToolTip="清除搜索">
                        <Button.Style>
                            <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=BrowseSearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="{DynamicResource IconFontFamily}" Text="&#xE711;" />
                    </Button>
                </Grid>
                <StackPanel x:Name="BrowseAdvancedFilters"
                            Grid.Column="2"
                            Orientation="Horizontal">
                    <ComboBox x:Name="BrowseKindFilterComboBox"
                              Width="132"
                              MinHeight="44"
                              Margin="0,0,8,0"
                              Style="{StaticResource ProblemFilterComboBox}"
                              ItemsSource="{Binding BrowsePageViewModel.KindFilterOptions}"
                              ItemTemplate="{StaticResource BrowseFilterOptionTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding BrowsePageViewModel.KindFilter}"
                              AutomationProperties.Name="项目类型筛选" />
                     <ToggleButton MinHeight="44"
                                  Margin="0,0,8,0"
                                  Padding="10,0"
                                  Style="{StaticResource FilterToggleButton}"
                                  IsChecked="{Binding BrowsePageViewModel.ShowOnlyProcessable}"
                                   AutomationProperties.Name="仅可处理（仅显示可处理项目）"
                                   Content="仅可处理" />
                    <ToggleButton MinHeight="44"
                                  Margin="0,0,8,0"
                                  Padding="10,0"
                                  Style="{StaticResource FilterToggleButton}"
                                  IsChecked="{Binding BrowsePageViewModel.ShowOnlyProblems}"
                                   AutomationProperties.Name="有问题（仅显示有问题项目）"
                                   Content="有问题" />
                    <Button x:Name="BrowseSelectVisibleProjectsButton"
                            MinWidth="106"
                            MinHeight="44"
                            Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowsePageViewModel.SelectVisibleProjectsCommand}"
                            ToolTip="{Binding BrowsePageViewModel.SelectionAvailabilityText}"
                            AutomationProperties.Name="选择匹配项（当前筛选结果）"
                            AutomationProperties.HelpText="{Binding BrowsePageViewModel.SelectionAvailabilityText}"
                            Content="选择匹配项" />
                    <ComboBox x:Name="BrowseSortComboBox"
                              Width="126"
                              MinHeight="44"
                              Style="{StaticResource ProblemFilterComboBox}"
                              ItemsSource="{Binding BrowsePageViewModel.SortOptions}"
                              ItemTemplate="{StaticResource BrowseFilterOptionTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding BrowsePageViewModel.Sort}"
                              AutomationProperties.Name="项目排序" />
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Grid.Row" Value="0" />
                            <Setter Property="Grid.Column" Value="2" />
                            <Setter Property="Grid.ColumnSpan" Value="1" />
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="{x:Static local:ShellLayoutMode.Compact}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                             Value="{x:Static local:ShellLayoutMode.Regular}">
                                    <Setter Property="Grid.Row" Value="1" />
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="3" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BrowseCompactSelectVisibleProjectsButton"
                            MinWidth="106"
                            MinHeight="44"
                            Margin="0,0,8,0"
                            Command="{Binding BrowsePageViewModel.SelectVisibleProjectsCommand}"
                            ToolTip="{Binding BrowsePageViewModel.SelectionAvailabilityText}"
                            AutomationProperties.Name="选择匹配项（当前筛选结果）"
                            AutomationProperties.HelpText="{Binding BrowsePageViewModel.SelectionAvailabilityText}"
                            Content="选择匹配项">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BrowseCompactDetailsButton"
                            MinWidth="104"
                            MinHeight="44"
                            Margin="0,0,8,0"
                            Click="BrowseCompactDetailsButton_Click"
                            AutomationProperties.Name="查看详情（当前项目）"
                            Content="查看详情">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                       Value="{x:Static local:ShellLayoutMode.Compact}" />
                                            <Condition Binding="{Binding BrowsePageViewModel.HasCurrentProject}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BrowseFilterButton"
                            MinWidth="96"
                            MinHeight="44"
                            Click="BrowseFilterButton_Click"
                            AutomationProperties.Name="筛选（打开项目筛选）"
                            Content="筛选">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                 Value="{x:Static local:ShellLayoutMode.Compact}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Border x:Name="BrowseEmptyState"
                    Padding="28"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.HasVisibleProjects}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <!-- Empty-set mark: icon in a square outlined frame with the cut corner. -->
                    <Grid Width="56"
                          Height="56"
                          HorizontalAlignment="Center"
                          IsHitTestVisible="False">
                        <Border BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1" />
                        <Path Width="10"
                              Height="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 10,0 10,10 Z"
                              Fill="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource IconFontFamily}"
                                   FontSize="24"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="&#xE8B7;" />
                    </Grid>
                    <TextBlock Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource TechnicalLabel}"
                               Text="NO RECORDS / 无可显示项目" />
                    <TextBlock x:Name="BrowseEmptyTitle"
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding BrowsePageViewModel.EmptyTitle}" />
                    <TextBlock Margin="0,7,0,0"
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Text="{Binding BrowsePageViewModel.EmptyDescription}" />
                    <TextBlock x:Name="BrowseFilteredEmptyDetailText"
                               Margin="0,7,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding BrowsePageViewModel.FilteredEmptyDetailText}"
                               Visibility="{Binding BrowsePageViewModel.ShowClearFiltersAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="BrowseScanCenterButton"
                             Margin="0,18,0,0"
                             MinWidth="160"
                             MinHeight="44"
                             Style="{StaticResource PrimaryButton}"
                             Command="{Binding NavigateScanCommand}"
                             AutomationProperties.Name="前往扫描中心"
                             Content="前往扫描中心"
                             Visibility="{Binding BrowsePageViewModel.ShowScanCenterAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button x:Name="BrowseClearFiltersButton"
                            Margin="0,18,0,0"
                            MinWidth="160"
                            MinHeight="44"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowsePageViewModel.ClearFiltersCommand}"
                            AutomationProperties.Name="清除筛选条件（项目浏览）"
                            Content="清除筛选条件"
                            Visibility="{Binding BrowsePageViewModel.ShowClearFiltersAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Grid x:Name="BrowseReadyState">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.HasVisibleProjects}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsDetailsOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsFilterLayerOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="BrowseDetailGapColumn" Width="10" />
                    <ColumnDefinition x:Name="BrowseDetailColumn" Width="300" />
                </Grid.ColumnDefinitions>
                <Border x:Name="BrowseGridHost"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="0"
                        ClipToBounds="True"
                        SizeChanged="BrowseGridHost_SizeChanged">
                    <ListBox x:Name="BrowseProjectGrid"
                             Background="Transparent"
                             BorderThickness="0"
                             Focusable="True"
                             IsTabStop="True"
                             KeyboardNavigation.TabNavigation="Continue"
                             GotKeyboardFocus="BrowseProjectGrid_GotKeyboardFocus"
                             ItemsSource="{Binding BrowsePageViewModel.Rows}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.CacheLength="0.5">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollContentPresenter}}}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:BrowseRowViewModel}">
                                <UniformGrid UseLayoutRounding="False"
                                             Columns="{Binding Projects.Count}">
                                    <UniformGrid.Resources>
                                        <Style x:Key="BrowseProjectSlotPresenter" TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <Trigger Property="Content" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <DataTemplate x:Key="BrowseProjectCardTemplate">
                                            <Grid x:Name="BrowseProjectCardRoot" Margin="3">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Hidden" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Button x:Name="BrowseProjectCardButton"
                                                        Style="{StaticResource BrowseProjectCardButton}"
                                                        IsTabStop="{Binding IsRovingTabStop}"
                                                        Click="BrowseProjectCardButton_Click"
                                                        PreviewKeyDown="BrowseProjectCardButton_PreviewKeyDown"
                                                        SizeChanged="BrowseProjectCardButton_SizeChanged"
                                                        MouseEnter="BrowseProjectCardButton_VisualStateChanged"
                                                        MouseLeave="BrowseProjectCardButton_VisualStateChanged"
                                                        GotKeyboardFocus="BrowseProjectCardButton_VisualStateChanged"
                                                        LostKeyboardFocus="BrowseProjectCardButton_VisualStateChanged"
                                                        AutomationProperties.Name="{Binding AutomationSummary}">
                                                    <Grid ClipToBounds="True">
                                                        <Grid x:Name="BrowsePreviewLayer"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                                                            <Border Background="{DynamicResource InkSoftBrush}">
                                                                <Grid>
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   FontFamily="{DynamicResource IconFontFamily}"
                                                                                   FontSize="22"
                                                                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                                                   Text="&#xE91B;" />
                                                                        <TextBlock Margin="0,4,0,0"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource PaperBrush}"
                                                                                   Text="静态预览" />
                                                                    </StackPanel>
                                                                    <controls:ThumbnailPreviewImage ThumbnailService="{Binding Owner.ThumbnailService}"
                                                                                                    ProjectKey="{Binding ProjectKey}"
                                                                                                    SourcePath="{Binding PreviewPath}"
                                                                                                    ScanFileLength="{Binding PreviewFileLength}"
                                                                                                    ScanLastWriteTimeUtc="{Binding PreviewLastWriteTimeUtc}"
                                                                                                    PreviewFormat="{Binding PreviewFormat}"
                                                                                                    SnapshotGeneration="{Binding Owner.ThumbnailGeneration}"
                                                                                                    DecodePixelWidth="320"
                                                                                                    Stretch="UniformToFill"
                                                                                                    RenderOptions.BitmapScalingMode="HighQuality" />
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                         <Border x:Name="BrowseProjectMetadata"
                                                                 MaxHeight="74"
                                                                 Padding="8,4"
                                                                 VerticalAlignment="Bottom"
                                                                Background="{DynamicResource OverlayBrush}"
                                                                ClipToBounds="True">
                                                            <Grid ClipToBounds="True">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>
                                                                 <TextBlock Height="18"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PaperBrush}"
                                                                           LineHeight="16"
                                                                           LineStackingStrategy="BlockLineHeight"
                                                                           Text="{Binding Title}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           TextWrapping="NoWrap" />
                                                                 <TextBlock Grid.Row="1"
                                                                           Height="12"
                                                                           Margin="0,0,0,1"
                                                                           FontFamily="{DynamicResource TechnicalFontFamily}"
                                                                           FontSize="{DynamicResource FontSizeMicro}"
                                                                           Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                                           LineHeight="12"
                                                                           Text="{Binding WorkshopId, StringFormat=ID {0}}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                 <Grid Grid.Row="2" Height="12" Margin="0,0,0,1">
                                                                     <TextBlock HorizontalAlignment="Left"
                                                                                FontFamily="{DynamicResource TechnicalFontFamily}"
                                                                                FontSize="{DynamicResource FontSizeMicro}"
                                                                                Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                                                LineHeight="12"
                                                                                Text="{Binding TypeLabel}" />
                                                                     <TextBlock HorizontalAlignment="Right"
                                                                                FontFamily="{DynamicResource TechnicalFontFamily}"
                                                                                FontSize="{DynamicResource FontSizeMicro}"
                                                                                Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                                                                LineHeight="12"
                                                                                Text="{Binding WarningCount, StringFormat=! {0}}" />
                                                                 </Grid>
                                                                 <TextBlock x:Name="BrowseProjectProcessabilityText"
                                                                            Grid.Row="3"
                                                                            Height="12"
                                                                            FontSize="{DynamicResource FontSizeMicro}"
                                                                            FontWeight="SemiBold"
                                                                            Foreground="{DynamicResource SignalBrush}"
                                                                            LineHeight="12"
                                                                            Text="{Binding ProcessabilityText}"
                                                                            TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Hidden" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsProcessable}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>
                                                        </Border>
                                                        <Border Margin="2"
                                                                BorderBrush="{DynamicResource SignalBrush}"
                                                                BorderThickness="2"
                                                                IsHitTestVisible="False">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Border Width="3"
                                                                HorizontalAlignment="Left"
                                                                Background="{DynamicResource AccentActionBrush}"
                                                                IsHitTestVisible="False">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                                <controls:BrowseSelectionToggle x:Name="BrowseProjectSelectionToggle"
                                                          Width="40"
                                                          Height="40"
                                                          Margin="4"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Top"
                                                          Panel.ZIndex="5"
                                                          IsTabStop="False"
                                                          Focusable="False"
                                                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                          SelectionRequested="BrowseProjectSelectionToggle_SelectionRequested"
                                                          AutomationProperties.HelpText="{Binding Owner.SelectionAvailabilityText}"
                                                          AutomationProperties.Name="{Binding Title, StringFormat=切换处理选择：{0}}">
                                                    <controls:BrowseSelectionToggle.Style>
                                                        <Style TargetType="{x:Type controls:BrowseSelectionToggle}"
                                                               BasedOn="{StaticResource WorkspaceCheckBox}">
                                                            <Setter Property="IsEnabled" Value="True" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProcessable}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsProcessable}" Value="True" />
                                                                        <Condition Binding="{Binding IsSelected}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsProcessable}" Value="True" />
                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=BrowseProjectCardRoot}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsProcessable}" Value="True" />
                                                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=BrowseProjectCardButton}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </MultiDataTrigger>
                                                                <DataTrigger Binding="{Binding Owner.IsSelectionWritable}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:BrowseSelectionToggle.Style>
                                                </controls:BrowseSelectionToggle>
                                            </Grid>
                                        </DataTemplate>
                                    </UniformGrid.Resources>
                                    <ContentPresenter Content="{Binding Slot0}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                    <ContentPresenter Content="{Binding Slot1}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                    <ContentPresenter Content="{Binding Slot2}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                    <ContentPresenter Content="{Binding Slot3}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                    <ContentPresenter Content="{Binding Slot4}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                    <ContentPresenter Content="{Binding Slot5}" ContentTemplate="{StaticResource BrowseProjectCardTemplate}" Style="{StaticResource BrowseProjectSlotPresenter}" />
                                </UniformGrid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border x:Name="BrowsePersistentDetails"
                        Grid.Column="2"
                        Focusable="False"
                        KeyboardNavigation.IsTabStop="False"
                        AutomationProperties.Name="当前项目详情"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <!-- Inspector marks, drawn beneath the scroll content: a signal lead on the top edge,
                             the cut corner, and a muted action dock behind the shared actions template. -->
                        <Border Width="48"
                                Height="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentActionBrush}"
                                IsHitTestVisible="False" />
                        <Path Width="10"
                              Height="10"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Data="M 0,0 L 10,0 10,10 Z"
                              Fill="{DynamicResource TextPrimaryBrush}"
                              IsHitTestVisible="False" />
                        <Border Grid.Row="1"
                                Background="{DynamicResource SurfaceMutedBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                IsHitTestVisible="False" />
                        <ScrollViewer x:Name="BrowsePersistentDetailsScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="True"
                                      KeyboardNavigation.IsTabStop="False"
                                      FocusVisualStyle="{DynamicResource FocusVisual}"
                                      AutomationProperties.Name="当前项目详情内容">
                            <ContentControl Focusable="False"
                                            KeyboardNavigation.IsTabStop="False"
                                            Content="{Binding BrowsePageViewModel.CurrentProject}"
                                            ContentTemplate="{StaticResource BrowseProjectDetailsTemplate}" />
                        </ScrollViewer>
                        <ContentControl x:Name="BrowsePersistentActionsHost"
                                        Grid.Row="1"
                                        Focusable="False"
                                        KeyboardNavigation.IsTabStop="False"
                                        Content="{Binding}"
                                        ContentTemplate="{StaticResource BrowseProjectActionsTemplate}" />
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="BrowseCompactModalBackdrop"
                    Panel.ZIndex="9"
                    Background="{DynamicResource ModalBackdropBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsDetailsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsFilterLayerOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <Border x:Name="BrowseCompactDetailsOverlay"
                    Width="320"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="3,0,0,0"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="BrowseCompactLayer_PreviewKeyDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsDetailsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <!-- Sheet header rule, caption and cut corner; the muted dock sits behind the actions. -->
                    <Border BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            IsHitTestVisible="False" />
                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <Border Width="40"
                                Height="3"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentActionBrush}" />
                        <TextBlock Style="{StaticResource TechnicalLabel}"
                                   Text="INSPECTOR / 项目详情" />
                    </StackPanel>
                    <Path Width="10"
                          Height="10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Data="M 0,0 L 10,0 10,10 Z"
                          Fill="{DynamicResource TextPrimaryBrush}"
                          IsHitTestVisible="False" />
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceMutedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            IsHitTestVisible="False" />
                    <Button x:Name="BrowseDetailCloseButton"
                            Margin="12"
                            HorizontalAlignment="Right"
                            MinWidth="92"
                            MinHeight="44"
                             Style="{StaticResource SecondaryButton}"
                             Click="BrowseDetailCloseButton_Click"
                             AutomationProperties.Name="关闭（项目详情）"
                             Content="关闭" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Focusable="False"
                                        KeyboardNavigation.IsTabStop="False"
                                        Content="{Binding BrowsePageViewModel.CurrentProject}"
                                        ContentTemplate="{StaticResource BrowseProjectDetailsTemplate}" />
                    </ScrollViewer>
                    <ContentControl x:Name="BrowseCompactActionsHost"
                                    Grid.Row="2"
                                    Focusable="False"
                                    KeyboardNavigation.IsTabStop="False"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource BrowseProjectActionsTemplate}" />
                </Grid>
            </Border>

            <Border x:Name="BrowseCompactFilterLayer"
                    Width="340"
                    HorizontalAlignment="Right"
                    Panel.ZIndex="11"
                    Padding="18"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource TextPrimaryBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="0"
                    KeyboardNavigation.TabNavigation="Cycle"
                    PreviewKeyDown="BrowseCompactLayer_PreviewKeyDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BrowsePageViewModel.IsFilterLayerOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border Width="40"
                                    Height="3"
                                    Margin="0,0,0,6"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentActionBrush}" />
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="筛选与排序" />
                        </StackPanel>
                        <Button x:Name="BrowseFilterCloseButton"
                                HorizontalAlignment="Right"
                                MinWidth="82"
                                MinHeight="44"
                                 Style="{StaticResource SecondaryButton}"
                                 Click="BrowseFilterCloseButton_Click"
                                 AutomationProperties.Name="完成（关闭项目筛选）"
                                 Content="完成" />
                    </Grid>
                    <TextBlock Margin="0,16,0,6" Style="{StaticResource TechnicalLabel}" Text="项目类型" />
                    <ComboBox x:Name="BrowseCompactKindFilterComboBox"
                              MinHeight="44"
                              Style="{StaticResource ProblemFilterComboBox}"
                              ItemsSource="{Binding BrowsePageViewModel.KindFilterOptions}"
                              ItemTemplate="{StaticResource BrowseFilterOptionTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding BrowsePageViewModel.KindFilter}"
                              AutomationProperties.Name="项目类型筛选" />
                    <ToggleButton Margin="0,10,0,0" MinHeight="44" Style="{StaticResource FilterToggleButton}" IsChecked="{Binding BrowsePageViewModel.ShowOnlyProcessable}" AutomationProperties.Name="仅可处理（仅显示可处理项目）" Content="仅可处理" />
                    <ToggleButton Margin="0,8,0,0" MinHeight="44" Style="{StaticResource FilterToggleButton}" IsChecked="{Binding BrowsePageViewModel.ShowOnlyProblems}" AutomationProperties.Name="有问题（仅显示有问题项目）" Content="有问题" />
                    <TextBlock Margin="0,16,0,6" Style="{StaticResource TechnicalLabel}" Text="排序" />
                    <ComboBox x:Name="BrowseCompactSortComboBox"
                              MinHeight="44"
                              Style="{StaticResource ProblemFilterComboBox}"
                              ItemsSource="{Binding BrowsePageViewModel.SortOptions}"
                              ItemTemplate="{StaticResource BrowseFilterOptionTemplate}"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding BrowsePageViewModel.Sort}"
                              AutomationProperties.Name="项目排序" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Processing dock: the one ink block on the page, capped by a 2px signal rule. Shown and hidden
             only through Opacity and IsHitTestVisible so its 72px row never reflows the grid. -->
        <Border x:Name="BrowseProcessingTraySlot"
                Grid.Row="5"
                Height="{DynamicResource BrowseProcessingTrayHeight}"
                Padding="10,7"
                Background="{DynamicResource InkBrush}"
                BorderBrush="{DynamicResource SignalBrush}"
                BorderThickness="0,2,0,0"
                CornerRadius="0"
                AutomationProperties.Name="项目处理状态">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BrowsePageViewModel.HasSelection}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UnpackSession.HasActiveScope}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UnpackSession.HasCompletionSummary}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="IsHitTestVisible" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock x:Name="BrowseProcessingLiveRegion"
                           Panel.ZIndex="-1"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch"
                           Opacity="0"
                           IsHitTestVisible="False"
                           Focusable="False"
                           Text="{Binding UnpackSession.TrayLiveRegionText}"
                           AutomationProperties.AutomationId="BrowseProcessingLiveRegion"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="项目处理状态" />
                <Grid x:Name="BrowseSelectionTray">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding BrowsePageViewModel.HasSelection}" Value="True" />
                                        <Condition Binding="{Binding UnpackSession.HasActiveScope}" Value="False" />
                                        <Condition Binding="{Binding UnpackSession.HasCompletionSummary}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource PaperBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding BrowsePageViewModel.SelectedCount, StringFormat=已选 {0:N0} 个项目}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   FontSize="10"
                                   Text="{Binding BrowseSelectionTrayStatusText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            MinWidth="92"
                            MinHeight="44"
                            Style="{StaticResource BrowseTrayGhostButton}"
                            Command="{Binding BrowsePageViewModel.ClearSelectionCommand}"
                            AutomationProperties.Name="清空选择（项目处理）"
                            Content="清空选择" />
                    <Button x:Name="BrowseProcessSelectionButton"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            MinWidth="124"
                            MinHeight="44"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ProcessBrowseSelectionCommand}"
                            ToolTip="{Binding BrowseSelectionActionAvailabilityText}"
                            AutomationProperties.HelpText="{Binding BrowseSelectionActionAvailabilityText}"
                            AutomationProperties.Name="{Binding BrowsePageViewModel.SelectedCount, StringFormat=处理已选 · {0:N0}}"
                            Content="{Binding BrowsePageViewModel.SelectedCount, StringFormat=处理已选 · {0:N0}}" />
                </Grid>

                <Grid x:Name="BrowseActiveProcessingTray">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnpackSession.HasActiveScope}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource SignalBrush}"
                               FontFamily="{DynamicResource TechnicalFontFamily}"
                               FontWeight="Bold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="RUN {0:N0} · PKG {1:N0} / VIDEO {2:N0}">
                                <Binding Path="UnpackSession.ActiveScope.TotalCount" />
                                <Binding Path="UnpackSession.ActiveScope.PackageCount" />
                                <Binding Path="UnpackSession.ActiveScope.VideoCount" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource PaperBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding UnpackSession.TrayStatusText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   FontFamily="{DynamicResource TechnicalFontFamily}"
                                   FontSize="10"
                                   Text="{Binding UnpackSession.WorkText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            MinWidth="104"
                            MinHeight="44"
                            Style="{StaticResource BrowseTrayGhostButton}"
                            Command="{Binding UnpackSession.CancelUnpackCommand}"
                            AutomationProperties.Name="安全取消（当前处理任务）"
                            Content="安全取消" />
                </Grid>

                <Grid x:Name="BrowseCompletionTray">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding UnpackSession.HasActiveScope}" Value="False" />
                                        <Condition Binding="{Binding UnpackSession.HasCompletionSummary}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource PaperBrush}"
                                   FontWeight="SemiBold"
                                   Text="{Binding UnpackSession.CompletionSummary.TotalCount, StringFormat=处理完成 · 共 {0:N0}}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextOnDarkMutedBrush}"
                                   FontFamily="{DynamicResource TechnicalFontFamily}"
                                   FontSize="10">
                            <Run Text="成功 " /><Run Text="{Binding UnpackSession.CompletionSummary.SucceededCount}" />
                            <Run Text=" · 失败 " /><Run Text="{Binding UnpackSession.CompletionSummary.FailedCount}" />
                            <Run Text=" · 跳过 " /><Run Text="{Binding UnpackSession.CompletionSummary.SkippedCount}" />
                            <Run Text=" · 取消 " /><Run Text="{Binding UnpackSession.CompletionSummary.CancelledCount}" />
                            <Run Text=" · 提交 " /><Run Text="{Binding UnpackSession.CompletionSummary.CommittedCount}" />
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="72" MinHeight="44"
                            Style="{StaticResource BrowseTrayGhostButton}"
                            Command="{Binding UnpackSession.ClearCompletionCommand}"
                            AutomationProperties.Name="清除项目处理完成摘要"
                            Content="清除" />
                    <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="88" MinHeight="44"
                            Style="{StaticResource BrowseTrayGhostButton}"
                            Command="{Binding NavigateProblemsCommand}"
                            AutomationProperties.Name="问题中心（打开）"
                            Content="问题中心" />
                    <Button Grid.Column="3" Margin="8,0,0,0" MinWidth="88" MinHeight="44"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NavigateLibraryCommand}"
                            AutomationProperties.Name="输出图库（打开）"
                            Content="输出图库" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
