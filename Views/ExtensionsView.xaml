<UserControl x:Class="FieldStation.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FieldStation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid x:Name="PageRoot" Margin="28,22,34,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="190" /><RowDefinition Height="17" /><RowDefinition Height="Auto" /><RowDefinition Height="17" /><RowDefinition Height="235" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="MODULE FABRIC / 05" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="扩展矩阵" Foreground="{StaticResource PaperBrush}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" /></StackPanel>

            <Border Grid.Row="2" Style="{StaticResource PaperPanel}" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions><StackPanel Margin="25" VerticalAlignment="Center"><TextBlock Text="THREE INDEPENDENT BOUNDARIES" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="后端、局部、整页。" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="39" FontWeight="Black" Margin="0,8,0,0" /><TextBlock Text="更换业务实现不需要修改 View；挂载局部控件不需要修改页面；注册整页模块不需要修改 MainWindow。" Foreground="#A0000000" FontSize="11" TextWrapping="Wrap" LineHeight="19" Margin="0,11,0,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource SignalBrush}" Margin="8"><Grid Margin="16"><TextBlock Text="05" Foreground="#16000000" FontFamily="{StaticResource DisplayFont}" FontSize="108" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Center" /><StackPanel VerticalAlignment="Center"><TextBlock Text="BUSINESS" Style="{StaticResource MicroLabel}" /><TextBlock Text="IOperationsBackend" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" /><Rectangle Height="1" Fill="#3A000000" Margin="0,8" /><TextBlock Text="LOCAL UI" Style="{StaticResource MicroLabel}" /><TextBlock Text="RegionRegistry" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" /><Rectangle Height="1" Fill="#3A000000" Margin="0,8" /><TextBlock Text="FULL PAGE" Style="{StaticResource MicroLabel}" /><TextBlock Text="PageRegistry" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel></Grid></Border></Grid></Border>

            <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="AVAILABLE EXTENSION POINTS" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="命名扩展点" Foreground="{StaticResource PaperBrush}" FontSize="21" FontWeight="Bold" Margin="0,3,0,0" /></StackPanel><TextBlock Text="FACTORY BASED / SAFE VISUAL OWNERSHIP" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" /></DockPanel>
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Slots}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource DarkPanel}" MinHeight="146" Margin="0,0,11,11" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding Index}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding Type}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel><StackPanel Grid.Row="1" Margin="0,12,0,10"><TextBlock Text="{Binding Title}" Foreground="{StaticResource PaperBrush}" FontSize="13" FontWeight="Bold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource White52Brush}" FontSize="9" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel><Border Grid.Row="2" Background="#0FFFFFFF" Padding="8,6"><TextBlock Text="{Binding Key}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="8" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource DarkPanel}" Padding="14"><controls:RegionHost RegionKey="extensions.canvas" Title="完整模块画布" Description="注册后可承载你的编辑器、数据库工具、可视化或完整业务前端，同时保留全局导航、状态与动效策略。" /></Border>
        </Grid>
    </ScrollViewer>
</UserControl>
