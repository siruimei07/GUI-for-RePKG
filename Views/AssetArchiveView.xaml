<UserControl x:Class="FieldStation.Views.AssetArchiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FieldStation.Controls">
    <UserControl.Resources>
        <DrawingBrush x:Key="ArchiveGrid" TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute" Viewbox="0,0,30,30" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing><GeometryDrawing Brush="#202020"><GeometryDrawing.Pen><Pen Brush="#10FFFFFF" Thickness="1" /></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="30,0" /><LineGeometry StartPoint="0,0" EndPoint="0,30" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="ArchiveItem" TargetType="ListBoxItem">
            <Setter Property="Width" Value="220" /><Setter Property="Height" Value="172" /><Setter Property="Margin" Value="0,0,11,11" />
            <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="{StaticResource ArchiveGrid}" />
            <Setter Property="BorderBrush" Value="{StaticResource White14Brush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="White" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource SignalBrush}" /><Setter Property="BorderThickness" Value="2" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="White" /><Setter Property="BorderThickness" Value="3" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="PageRoot" Margin="28,22,34,26">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="16" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ASSET ARCHIVE / 03" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="资产档案" Foreground="{StaticResource PaperBrush}" Style="{StaticResource PageTitle}" Margin="0,4,0,0" /></StackPanel><Grid Grid.Column="1" VerticalAlignment="Center"><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="37,10,12,10" ToolTip="按名称或 ID 搜索" /><TextBlock Text="⌕" Foreground="{StaticResource SignalBrush}" FontSize="19" VerticalAlignment="Center" Margin="12,0,0,1" IsHitTestVisible="False" /></Grid></Grid>

        <!-- Archive mode reverses the command composition: selected media owns a pale stage. -->
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="0.78*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.32*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PaperPanel}" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="{Binding SelectedAsset.Index, TargetNullValue=00}" Foreground="#0C000000" FontFamily="{StaticResource DisplayFont}" FontSize="300" FontWeight="Black" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-28,-85" />
                    <Path Data="M60,520 L340,70 L560,70 L280,520 Z" Fill="#10000000" Stretch="None" HorizontalAlignment="Right" />
                    <Ellipse Width="280" Height="280" Stroke="#20000000" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0" />
                    <Line X1="0" Y1="0" X2="235" Y2="0" Stroke="{StaticResource SignalBrush}" StrokeThickness="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,62,0" RenderTransformOrigin="0.5,0.5"><Line.RenderTransform><RotateTransform Angle="-48" /></Line.RenderTransform></Line>
                    <Grid Margin="25"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel><TextBlock Text="FOCUSED RECORD" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedAsset.Category}" Foreground="{StaticResource InkBrush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding SelectedAsset.Name, TargetNullValue=未选择资产}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="42" FontWeight="Black" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedAsset.Id}" Foreground="#99000000" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,7,0,0" /><Border Background="{StaticResource InkBrush}" HorizontalAlignment="Left" Padding="10,6" Margin="0,18,0,0"><TextBlock Text="{Binding SelectedAsset.Status}" Foreground="{StaticResource SignalBrush}" Style="{StaticResource MicroLabel}" /></Border></StackPanel>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="REVISION" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedAsset.Revision, StringFormat=R{0:00}}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Black" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="UPDATED" Foreground="#77000000" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding SelectedAsset.UpdatedAt}" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Black" Margin="0,4,0,0" /></StackPanel></Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions>
                <DockPanel><TextBlock Text="RECORD MATRIX" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" VerticalAlignment="Center" /><ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" Width="132" HorizontalAlignment="Right" Padding="8" FontFamily="{StaticResource MonoFont}" FontSize="9" /></DockPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}" ItemContainerStyle="{StaticResource ArchiveItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="13,11"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><DockPanel><TextBlock Text="{Binding Index}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" FontWeight="Bold" /><TextBlock Text="{Binding Category}" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" /></DockPanel><StackPanel Grid.Row="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="{StaticResource PaperBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Id}" Foreground="{StaticResource White52Brush}" FontFamily="{StaticResource MonoFont}" FontSize="8" Margin="0,4,0,0" /></StackPanel><DockPanel Grid.Row="2"><Rectangle Width="18" Height="3" Fill="{StaticResource SignalBrush}" Margin="0,0,7,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource White76Brush}" FontSize="9" /></DockPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="2" Style="{StaticResource DarkPanel}" Padding="13" Margin="0,11,0,0"><controls:RegionHost RegionKey="archive.preview" Title="资产预览器" Description="挂载文件树、编辑器、媒体或领域元数据。" /></Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
