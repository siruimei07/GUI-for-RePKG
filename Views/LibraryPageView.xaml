<UserControl x:Class="WallpaperField.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperField"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <!-- Library mode replaces the route with an indexed media aperture. -->
        <Canvas x:Name="LibraryStageOverlay"
                IsHitTestVisible="False"
                Opacity="0.12">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <Path Stroke="{DynamicResource InkBrush}"
                  StrokeThickness="1"
                  Data="M 64,300 L 64,258 L 104,258 M 64,300 L 64,660 L 104,660 M 1040,258 L 1080,258 L 1080,300 M 1040,660 L 1080,660 L 1080,620" />
            <Line X1="128" Y1="286" X2="1016" Y2="286" Stroke="{DynamicResource InkBrush}" StrokeDashArray="1,12" />
            <Line X1="128" Y1="632" X2="1016" Y2="632" Stroke="{DynamicResource InkBrush}" StrokeDashArray="1,12" />
            <TextBlock Canvas.Left="82" Canvas.Top="318"
                       FontFamily="Arial Narrow"
                       FontSize="62"
                       FontWeight="Black"
                       Foreground="{DynamicResource InkBrush}"
                       Text="MEDIA / CATALOG" />
            <TextBlock Canvas.Left="84" Canvas.Top="382"
                       Style="{StaticResource TechnicalLabel}"
                       Text="OUTPUT ROOT · METADATA · PREVIEW · FOLDER ACCESS" />
        </Canvas>
        <!-- Page 02: output library -->
        <Grid x:Name="LibraryView" RenderTransformOrigin="0.5,0.5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="34,24,28,20" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                            <Setter Property="Margin" Value="22,16,18,14" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Regular}">
                            <Setter Property="Margin" Value="28,20,22,16" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <Grid x:Name="LibraryPageHeader" Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource TechnicalLabel}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="LOCAL ARCHIVE / 02 · OUTPUT CATALOG" />
                            <TextBlock x:Name="LibraryPageTitle"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="输出壁纸库" />
                            <TextBlock x:Name="LibraryDescription"
                                       Margin="2,9,0,0"
                                       MaxWidth="650"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="从指定输出目录递归读取已保存的元数据与 preview；点击任一卡片即可在文件管理器中定位。"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel x:Name="LibraryStats" Grid.Column="1" Margin="24,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource TechnicalLabel}" Text="AVAILABLE RECORDS" />
                            <TextBlock HorizontalAlignment="Right" Margin="0,2,0,0" FontFamily="Arial Narrow" FontSize="34" FontWeight="Bold" Text="{Binding LibrarySession.Count, StringFormat={}{0:00}}" />
                        </StackPanel>
                        <StackPanel x:Name="LibraryActionPanel"
                                    Grid.Column="2"
                                    Margin="16,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="RefreshLibraryButton"
                                    MinWidth="144"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshLibraryCommand}"
                                    AutomationProperties.Name="刷新输出壁纸库">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" Text="&#xE72C;" />
                                    <TextBlock Text="刷新输出库" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelLibraryRefreshButton"
                                    MinWidth="144"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding LibrarySession.CancelRefreshCommand}"
                                    Visibility="{Binding LibrarySession.IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="取消图库刷新"
                                    Content="取消图库刷新" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="LibraryPathPanel"
                            Grid.Row="1"
                            Margin="0,0,0,14"
                            Padding="18,14"
                            Background="{DynamicResource InkBrush}"
                            CornerRadius="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="{DynamicResource SignalBrush}" CornerRadius="11">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{DynamicResource SignalTextBrush}" Text="&#xE8B7;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="13,0,18,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="ACTIVE OUTPUT ROOT" />
                                <TextBlock Margin="0,3,0,0" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource PaperBrush}" Text="{Binding LibrarySession.OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibrarySession.OutputPath}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    MinWidth="116"
                                    Style="{StaticResource GhostButton}"
                                    Foreground="{DynamicResource PaperBrush}"
                                    BorderBrush="{DynamicResource Paper24Brush}"
                                    Command="{Binding BrowseOutputCommand}"
                                    Content="更换目录" />
                        </Grid>
                    </Border>

                    <Border x:Name="LibraryProblemSummary"
                            Grid.Row="2"
                            Margin="0,0,0,12"
                            Padding="14,11"
                            Background="{DynamicResource PaperElevatedBrush}"
                            BorderBrush="{DynamicResource SignalPressedBrush}"
                            BorderThickness="5,1,1,1"
                            CornerRadius="12"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="{DynamicResource SignalBrush}" CornerRadius="8">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Black" Foreground="{DynamicResource SignalTextBrush}" Text="!" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                <TextBlock Style="{StaticResource TechnicalLabel}" Text="PROBLEM SUMMARY / 输出图库" />
                                <TextBlock Margin="0,4,0,0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InkBrush}"
                                           Text="{Binding ProblemCenterSession.LibrarySummary}" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    MinWidth="124"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding NavigateProblemsCommand}"
                                    Content="查看全部问题"
                                    AutomationProperties.Name="查看全部输出图库问题" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="2,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="壁纸记录" />
                            <TextBlock Margin="0,3,0,0"
                                       Style="{StaticResource TechnicalLabel}"
                                       Text="NAME FILTER / 实时筛选" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="1" Margin="16,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
                        <Grid x:Name="LibrarySearchPanel"
                              Grid.Column="2"
                              Height="50">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="430" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Width" Value="320" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBox x:Name="LibrarySearchBox"
                                     Style="{StaticResource SearchTextBox}"
                                     AutomationProperties.Name="搜索输出壁纸库中的壁纸名称"
                                     AutomationProperties.HelpText="输入名称后仅显示标题中包含该关键词的壁纸"
                                     Text="{Binding LibrarySession.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="15"
                                       Foreground="{DynamicResource InkBrush}"
                                       Text="&#xE721;" />
                            <TextBlock Margin="47,0,154,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="输入壁纸名称">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LibrarySearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="32"
                                    Padding="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,7,0" />
                                        <Setter Property="Background" Value="{DynamicResource PaperMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Margin" Value="0,0,51,0" />
                                                <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                 <TextBlock VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource InkBrush}"
                                            AutomationProperties.LiveSetting="Polite">
                                     <AutomationProperties.Name>
                                         <MultiBinding StringFormat="输出壁纸库匹配 {0} 项，共 {1} 项">
                                             <Binding Path="FilteredLibraryCount" />
                                             <Binding Path="LibraryWallpapers.Count" />
                                         </MultiBinding>
                                     </AutomationProperties.Name>
                                     <TextBlock.Text>
                                        <MultiBinding StringFormat="MATCH {0:00} / {1:00}">
                                            <Binding Path="FilteredLibraryCount" />
                                            <Binding Path="LibraryWallpapers.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,3,0"
                                    Command="{Binding LibrarySession.ClearSearchCommand}"
                                    AutomationProperties.Name="清除输出壁纸库搜索"
                                    ToolTip="清除搜索"
                                    Content="&#xE711;">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Margin="2,0"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Height" Value="3" />
                                                <Setter Property="Background" Value="{DynamicResource SignalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" MinHeight="48">
                        <ListBox x:Name="LibraryResultsList"
                                 ItemsSource="{Binding LibrarySession.FilteredWallpapers}"
                                 ItemTemplate="{DynamicResource WallpaperCardTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <Border Padding="34"
                                Background="{DynamicResource PaperBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LibrarySession.HasVisibleResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="62" Height="62" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="31">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="25" Foreground="{DynamicResource TextMutedBrush}" Text="&#xE838;" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{Binding LibrarySession.EmptyTitle}" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding LibrarySession.EmptyDescription}" />
                            </StackPanel>
                        </Border>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
