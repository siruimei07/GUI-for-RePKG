<UserControl x:Class="WallpaperField.Views.LibraryPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WallpaperField"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">

    <Grid>
        <!-- Page 03: output library. The root stays transparent so the shell stage shows through. -->
        <Grid x:Name="LibraryView" RenderTransformOrigin="0.5,0.5">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="20,16,20,16" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLibraryPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                            <Setter Property="Margin" Value="12,10,12,10" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                     Value="{x:Static local:ShellLayoutMode.Regular}">
                            <Setter Property="Margin" Value="16,12,16,12" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    <Grid x:Name="LibraryPageHeader" Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <!-- Page coordinate: ink index chip + kicker. -->
                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False">
                                <Border Style="{StaticResource IndexChip}" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="03" />
                                </Border>
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource TechnicalLabel}"
                                           Text="LOCAL ARCHIVE / 本地归档" />
                            </StackPanel>
                            <TextBlock x:Name="LibraryPageTitle"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="输出壁纸库" />
                            <Grid Margin="0,7,0,0" IsHitTestVisible="False">
                                <Border Width="40"
                                        Height="3"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentActionBrush}" />
                                <Border Height="1"
                                        Margin="48,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource BorderBrush}" />
                            </Grid>
                            <TextBlock x:Name="LibraryDescription"
                                       Margin="0,8,0,0"
                                       MaxWidth="650"
                                       HorizontalAlignment="Left"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="从指定输出目录递归读取已保存的元数据与 preview；点击任一卡片即可在文件管理器中定位。"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                         Value="{x:Static local:ShellLayoutMode.Compact}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Record readout: hidden in Compact; the refresh action lives outside it. -->
                        <StackPanel x:Name="LibraryStats" Grid.Column="1" Margin="24,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="1" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                            <StackPanel Margin="14,0,0,0">
                                <TextBlock HorizontalAlignment="Right" Style="{StaticResource TechnicalLabel}" Text="RECORDS / 可用记录" />
                                <TextBlock HorizontalAlignment="Right" Margin="0,1,0,0" Style="{StaticResource StatReadout}" Text="{Binding LibrarySession.Count, StringFormat={}{0:00}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="LibraryActionPanel"
                                    Grid.Column="2"
                                    Margin="16,0,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom">
                            <Button x:Name="RefreshLibraryButton"
                                    MinWidth="144"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshLibraryCommand}"
                                    AutomationProperties.Name="刷新输出壁纸库">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" Text="&#xE72C;" />
                                    <TextBlock VerticalAlignment="Center" Text="刷新输出库" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CancelLibraryRefreshButton"
                                    MinWidth="144"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding LibrarySession.CancelRefreshCommand}"
                                    Visibility="{Binding LibrarySession.IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="取消图库刷新"
                                    Content="取消图库刷新" />
                        </StackPanel>
                    </Grid>

                    <!-- Path terminal: a deliberate ink slab with a cyan leading edge. -->
                    <Border x:Name="LibraryPathPanel"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Background="{DynamicResource InkBrush}"
                            BorderBrush="{DynamicResource AccentActionBrush}"
                            BorderThickness="4,0,0,0"
                            CornerRadius="0">
                        <Grid>
                            <Grid Margin="14,12,14,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34"
                                        Height="34"
                                        Background="{DynamicResource InkRaisedBrush}"
                                        BorderBrush="{DynamicResource InkSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        IsHitTestVisible="False">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" FontSize="15" Foreground="{DynamicResource SignalBrush}" Text="&#xE8B7;" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Foreground="{DynamicResource TextOnDarkMutedBrush}" Text="ACTIVE OUTPUT ROOT / 当前输出目录" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Width="5"
                                              Height="8"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Data="M 0,0 L 5,4 0,8"
                                              Stroke="{DynamicResource SignalBrush}"
                                              StrokeThickness="1.5"
                                              IsHitTestVisible="False" />
                                        <TextBlock Grid.Column="1" FontFamily="{DynamicResource TechnicalFontFamily}" FontSize="12" Foreground="{DynamicResource PaperBrush}" Text="{Binding LibrarySession.OutputPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LibrarySession.OutputPath}" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="116"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BrowseOutputCommand}"
                                        Content="更换目录" />
                            </Grid>
                            <Path Width="10"
                                  Height="10"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Top"
                                  Data="M 0,0 L 10,0 10,10 Z"
                                  Fill="{DynamicResource SignalBrush}"
                                  IsHitTestVisible="False" />
                        </Grid>
                    </Border>

                    <!-- Problem summary banner: white slab, 4px rail + square: amber "!" while library issues are open, cyan check when clear (mirrors Scan). -->
                    <Border x:Name="LibraryProblemSummary"
                            Grid.Row="2"
                            Margin="0,0,0,12"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0"
                            AutomationProperties.LiveSetting="Polite">
                        <Grid>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False" />
                            <Border Width="4" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProblemCenterSession.LibraryIssueCount}" Value="0">
                                                <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <Grid Margin="16,9,12,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="0" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProblemCenterSession.LibraryIssueCount}" Value="0">
                                                    <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource LabelFontFamily}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SignalTextBrush}" Text="!">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProblemCenterSession.LibraryIssueCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" FontSize="12" Foreground="{DynamicResource SignalTextBrush}" Text="&#xE73E;">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProblemCenterSession.LibraryIssueCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource TechnicalLabel}" Text="PROBLEM SUMMARY / 输出图库" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding ProblemCenterSession.LibrarySummary}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        MinWidth="124"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding NavigateProblemsCommand}"
                                        Content="查看全部问题"
                                        AutomationProperties.Name="查看全部输出图库问题" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="2,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3"
                                        Height="14"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource TextPrimaryBrush}"
                                        IsHitTestVisible="False" />
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="壁纸记录" />
                            </StackPanel>
                            <TextBlock Margin="11,3,0,0"
                                       Style="{StaticResource TechnicalLabel}"
                                       Text="NAME FILTER / 实时筛选" />
                        </StackPanel>
                        <Border Grid.Column="1" Height="1" Margin="16,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False" />
                        <Grid x:Name="LibrarySearchPanel"
                              Grid.Column="2"
                              Height="40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="430" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                     Value="{x:Static local:ShellLayoutMode.Compact}">
                                            <Setter Property="Width" Value="320" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <TextBox x:Name="LibrarySearchBox"
                                     Style="{StaticResource SearchTextBox}"
                                     AutomationProperties.Name="搜索输出壁纸库中的壁纸名称"
                                     AutomationProperties.HelpText="输入名称后仅显示标题中包含该关键词的壁纸"
                                     Text="{Binding LibrarySession.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}" />
                            <TextBlock Margin="16,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontFamily="{DynamicResource IconFontFamily}"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="&#xE721;" />
                            <TextBlock Margin="47,0,154,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="输入壁纸名称">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=LibrarySearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border Height="32"
                                    Padding="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Margin" Value="0,0,7,0" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Margin" Value="0,0,51,0" />
                                                <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                 <TextBlock VerticalAlignment="Center"
                                            FontFamily="{DynamicResource LabelFontFamily}"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Typography.NumeralAlignment="Tabular"
                                            AutomationProperties.LiveSetting="Polite">
                                     <TextBlock.Style>
                                         <Style TargetType="TextBlock">
                                             <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                             <Style.Triggers>
                                                 <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                     <Setter Property="Foreground" Value="{DynamicResource SignalTextBrush}" />
                                                 </DataTrigger>
                                             </Style.Triggers>
                                         </Style>
                                     </TextBlock.Style>
                                     <AutomationProperties.Name>
                                         <MultiBinding StringFormat="输出壁纸库匹配 {0} 项，共 {1} 项">
                                             <Binding Path="FilteredLibraryCount" />
                                             <Binding Path="LibraryWallpapers.Count" />
                                         </MultiBinding>
                                     </AutomationProperties.Name>
                                     <TextBlock.Text>
                                        <MultiBinding StringFormat="MATCH {0:00} / {1:00}">
                                            <Binding Path="FilteredLibraryCount" />
                                            <Binding Path="LibraryWallpapers.Count" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border>
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,3,0"
                                    Command="{Binding LibrarySession.ClearSearchCommand}"
                                    AutomationProperties.Name="清除输出壁纸库搜索"
                                    ToolTip="清除搜索"
                                    Content="&#xE711;">
                                <Button.Style>
                                    <Style BasedOn="{StaticResource IconButton}" TargetType="Button">
                                        <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Margin="2,0"
                                    VerticalAlignment="Bottom"
                                    IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Height" Value="1" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LibrarySession.HasSearchText}" Value="True">
                                                <Setter Property="Height" Value="3" />
                                                <Setter Property="Background" Value="{DynamicResource AccentActionBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="4" MinHeight="48">
                        <ListBox x:Name="LibraryResultsList"
                                 ItemsSource="{Binding LibrarySession.FilteredWallpapers}"
                                 ItemTemplate="{DynamicResource WallpaperCardTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.CacheLength="1,2"
                                 VirtualizingPanel.CacheLengthUnit="Page">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <!-- Empty state: white slab, cut-corner frame around the glyph, title + muted text. -->
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LibrarySession.HasVisibleResults}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="56" Height="56" HorizontalAlignment="Center" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="0">
                                        <Grid>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource IconFontFamily}" FontSize="24" Foreground="{DynamicResource TextMutedBrush}" Text="&#xE838;" />
                                            <Path Width="8"
                                                  Height="8"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  Data="M 0,0 L 8,0 8,8 Z"
                                                  Fill="{DynamicResource TextPrimaryBrush}"
                                                  IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                    <Border Width="24"
                                            Height="3"
                                            Margin="0,14,0,0"
                                            HorizontalAlignment="Center"
                                            Background="{DynamicResource AccentActionBrush}"
                                            IsHitTestVisible="False" />
                                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding LibrarySession.EmptyTitle}" TextAlignment="Center" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,6,0,0" MaxWidth="460" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding LibrarySession.EmptyDescription}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <Path Width="10"
                                      Height="10"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Top"
                                      Data="M 0,0 L 10,0 10,10 Z"
                                      Fill="{DynamicResource TextPrimaryBrush}"
                                      IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                    </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
