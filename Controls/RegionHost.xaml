<UserControl x:Class="FieldStation.Controls.RegionHost" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinHeight="118">
    <Grid>
        <Rectangle x:Name="EmptyFrame" Stroke="{StaticResource White28Brush}" StrokeDashArray="3 3" />
        <Grid x:Name="EmptyState" Margin="17">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Rectangle Width="5" Height="28" Fill="{StaticResource SignalBrush}" Margin="0,0,11,0" />
                <StackPanel><TextBlock Text="{Binding Title, ElementName=Root}" Foreground="{StaticResource PaperBrush}" FontWeight="Bold" FontSize="13" /><TextBlock Text="EXTENSIBLE REGION" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" Margin="0,2,0,0" /></StackPanel>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Description, ElementName=Root}" Foreground="{StaticResource White52Brush}" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" />
            <DockPanel Grid.Row="2"><TextBlock Text="REGION KEY" Foreground="{StaticResource White52Brush}" Style="{StaticResource MicroLabel}" /><TextBlock Text="{Binding RegionKey, ElementName=Root}" Foreground="{StaticResource SignalBrush}" FontFamily="{StaticResource MonoFont}" FontSize="9" HorizontalAlignment="Right" /></DockPanel>
        </Grid>
        <ContentPresenter x:Name="ResolvedContent" Visibility="Collapsed" />
    </Grid>
</UserControl>
